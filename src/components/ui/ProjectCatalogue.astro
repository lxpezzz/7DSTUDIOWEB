---
import { getDemoUrl, getProjectCaseStudyHref, type Project } from "../../data/projects";
import { Image } from "astro:assets";
interface Props {
  items: readonly Project[];
}
const { items } = Astro.props;
const catalogueId = `project-catalogue-${crypto.randomUUID()}`;
---

<div class="catalogue" data-project-catalogue hidden={items.length === 0}>
  <p class="catalogue__hint" id={`${catalogueId}-hint`}>
    Desliza para explorar. También puedes usar las flechas del teclado.
  </p>
  <div
    class="catalogue__track"
    id={catalogueId}
    role="region"
    aria-label="Catálogo horizontal de proyectos"
    aria-describedby={`${catalogueId}-hint`}
    tabindex="0"
  >
    {
      items.map((project) => {
        const caseHref = getProjectCaseStudyHref(project);
        const demoUrl = getDemoUrl(project.demoUrl);
        const cardHref = caseHref ?? demoUrl;
        const isExternal = !caseHref && Boolean(demoUrl);
        const Card = cardHref ? "a" : "article";
        return (
          <Card
            class:list={["project", { "project--linked": !!cardHref }]}
            data-project-id={project.id}
            href={cardHref}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
          >
            <div class="project__image">
              <Image
                src={project.image}
                width={1280}
                widths={[320, 480, 640, 960, 1280]}
                sizes="(max-width: 767px) 80vw, (max-width: 1023px) 57vw, (min-width: 1408px) 548px, 40vw"
                format="webp"
                quality={85}
                alt={project.image.alt}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="project__meta">
              <span>{project.sector}</span>
              <span
                class:list={[
                  "project__type",
                  { "project__type--demo": project.type === "demo" },
                ]}
              >
                {project.type === "demo" ? "DEMO CONCEPTUAL" : "PROYECTO REAL"}
              </span>
            </div>
            <h3>{project.title}</h3>
            <p class="project__description">{project.description}</p>
            {project.highlights && project.highlights.length > 0 && (
              <p class="project__highlights">
                {project.highlights.join(" · ")}
              </p>
            )}
            {cardHref && (
              <span class="text-link project__link">
                {caseHref ? "Ver caso de proyecto" : project.type === "demo" ? "Explorar demo" : "Explorar proyecto"}
                <span class="sr-only">
                  {" "}— {project.title}{isExternal ? " (se abre en una pestaña nueva)" : ""}
                </span>
                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <path d="M5 19 19 5M5 5h14v14" />
                </svg>
              </span>
            )}
          </Card>
        );
      })
    }
  </div>
  <div class="catalogue__controls" hidden>
    <p class="catalogue__position" aria-live="polite" aria-atomic="true"></p>
    <div class="catalogue__arrows">
      <button
        type="button"
        class="catalogue__previous"
        aria-label="Ver proyectos anteriores"
        aria-controls={catalogueId}
        disabled
        ><svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"><path d="M20 12H4m6-6-6 6 6 6"></path></svg
        ></button
      >
      <button
        type="button"
        class="catalogue__next"
        aria-label="Ver proyectos siguientes"
        aria-controls={catalogueId}
        disabled
        ><svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"></path></svg
        ></button
      >
    </div>
  </div>
</div>

<script>
  import { initProjectCatalogues } from "../../scripts/project-catalogue";
  initProjectCatalogues();
</script>

<style>
  .catalogue {
    margin-top: 48px;
    min-width: 0;
  }
  .catalogue__hint {
    margin: 0 0 16px;
    color: var(--color-muted);
    font-size: 12px;
    line-height: 1.6;
  }
  .catalogue__track {
    position: relative;
    display: flex;
    gap: 28px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 2px;
    overscroll-behavior-x: contain;
    padding: 6px 2px 20px;
    scrollbar-width: thin;
    scrollbar-color: var(--color-muted) var(--color-line);
  }
  .catalogue__track:focus-visible {
    outline-offset: 2px;
  }
  .project {
    display: block;
    flex: 0 0 calc((100% - 48px) / 2.25);
    min-width: 0;
    scroll-snap-align: start;
  }
  .project--linked {
    cursor: pointer;
  }
  .project--linked:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: -2px;
  }
  .project:only-child {
    flex-basis: min(100%, 900px);
  }
  .project__image {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--color-line);
    background: var(--color-line);
  }
  .project__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .project__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    justify-content: space-between;
    margin-top: 22px;
    color: var(--color-muted);
    font-size: 11px;
    line-height: 1.6;
  }
  .project__type {
    color: var(--color-muted);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .project__type--demo {
    color: var(--color-ink);
    padding: 2px 7px;
    border: 1px solid var(--color-line);
  }
  h3 {
    margin: 10px 0 0;
    font-size: clamp(25px, 2.6vw, 36px);
    font-weight: 450;
    line-height: 1.15;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .project__description {
    max-width: 44ch;
    margin: 14px 0 0;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  .project__highlights {
    margin: 10px 0 0;
    color: var(--color-muted);
    font-size: 12px;
    line-height: 1.6;
  }
  .project__link {
    margin-top: 14px;
  }
  .project--linked:hover .project__link {
    text-decoration-color: currentColor;
  }
  .catalogue__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 16px 28px;
  }
  .catalogue__position {
    margin: 0;
    color: var(--color-muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .catalogue__arrows {
    display: flex;
    gap: 8px;
  }
  .catalogue__arrows button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: 0;
    background: transparent;
    color: var(--color-ink);
  }
  .catalogue__arrows button:hover:not(:disabled) {
    background: var(--color-line);
  }
  .catalogue__arrows button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  @media (prefers-reduced-motion: no-preference) {
    .catalogue__track {
      scroll-behavior: smooth;
    }
    .project__image img {
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .project__link svg {
      transition: transform 0.3s ease;
    }
    .project--linked:focus-visible .project__link svg {
      transform: translate(3px, -3px);
    }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .project--linked:hover .project__image img {
      transform: scale(1.03);
    }
    .project--linked:hover .project__link svg {
      transform: translate(3px, -3px);
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .project {
      flex-basis: 62%;
    }
  }
  @media (max-width: 767px) {
    .catalogue {
      margin-top: 32px;
    }
    .catalogue__track {
      gap: 18px;
    }
    .project {
      flex-basis: 86%;
    }
    .project__meta {
      margin-top: 18px;
    }
    .project__description {
      font-size: 14px;
    }
  }
</style>
