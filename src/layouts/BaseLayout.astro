---
import '../styles/global.css';
import { site } from '../data/site';
import MobileStickyCta from '../components/layout/MobileStickyCta.astro';
import WhatsAppWidget from '../components/layout/WhatsAppWidget.astro';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
interface Props {
  title?: string;
  description?: string;
  structuredData?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title = site.title, description = site.description, structuredData = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  description: site.description,
  telephone: '+34621200800',
  areaServed: { '@type': 'Place', name: 'Castellón de la Plana, España' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog', name: 'Servicios digitales',
    itemListElement: ['Diseño web', 'SEO local', 'Soluciones digitales'].map(name => ({
      '@type': 'Offer', itemOffered: { '@type': 'Service', name },
    })),
  },
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#F8F7F4" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="7D Studio. Tu negocio, mejor presentado. Y más fácil de encontrar." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {structuredData.map(data => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
  </head>
  <body>

    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <MobileStickyCta />
    <WhatsAppWidget />
  </body>
</html>
