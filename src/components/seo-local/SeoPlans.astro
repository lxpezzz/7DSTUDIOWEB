---
import { seoPlans, seoPlanNotes, getSeoPlanHref } from '../../data/seoPlans';
import { site } from '../../data/site';
import { Check, Minus, MonitorCheck, FileSearch, CircleOff } from 'lucide';
const plans = [...seoPlans].sort((a, b) => a.order - b.order);
const currency = new Intl.NumberFormat('es-ES', {
  style: 'currency',
  currency: 'EUR',
  minimumFractionDigits: 0,
  maximumFractionDigits: 2,
});
const helpHref = new URL(site.whatsapp);
helpHref.searchParams.set('text', 'Hola, no sé qué plan de SEO local elegir para mi negocio. ¿Podéis orientarme?');
---

<section id="planes" class="plans container" aria-labelledby="plans-title">
  <div class="plans__heading">
    <p class="plans__label">PLANES SEO LOCAL</p>
    <h2 id="plans-title">Elige cómo mejorar tu presencia en Google.</h2>
    <p>Dos planes para negocios con diferentes necesidades. Te ayudamos a encontrar el más adecuado.</p>
  </div>
  <div class="plans__grid">
    {plans.map(plan => <article class:list={['plan', { 'plan--featured': plan.featured }]} data-plan={plan.id} aria-labelledby={`${plan.id}-title`}>
      <div class="plan__intro">
        {plan.badge && <p class="plan__badge">{plan.badge}</p>}
        <h3 id={`${plan.id}-title`}>{plan.name}</h3>
        <p class="plan__description">{plan.description}</p>
        <p class="plan__price"><strong>{currency.format(plan.price)}</strong><span>{plan.period}</span><small>{plan.taxLabel}</small></p>
      </div>
      {plan.included.length > 0 && (
        <div class="plan__features">
          <h4>Incluye</h4>
          <ul role="list">
            {plan.included.map(feature => (
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {Check.map(([Tag, attributes]) => <Tag {...attributes} />)}
                </svg>
                <span>{feature}</span>
                {feature.endsWith('*') && (
                  <svg class="plan__web-access" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Requiere acceso autorizado a una web activa">
                    <title>Requiere acceso autorizado a una web activa</title>
                    {MonitorCheck.map(([Tag, attributes]) => <Tag {...attributes} />)}
                  </svg>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}
      {plan.excluded.length > 0 && (
        <div class="plan__features plan__features--excluded">
          <h4>No incluye</h4>
          <ul role="list">
            {plan.excluded.map(feature => (
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {Minus.map(([Tag, attributes]) => <Tag {...attributes} />)}
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
      {plan.scopeNote && <p class="plan__scope">{plan.scopeNote}</p>}
      <a class="plan__button button" href={getSeoPlanHref(plan)} data-seo-plan={plan.id} data-seo-plan-name={plan.name}>{plan.cta}<span aria-hidden="true">↗</span><span class="sr-only"> (formulario de contacto en esta página)</span></a>
    </article>)}
  </div>
  <div class="plans__conditions">
    <article class="plans__condition" aria-labelledby="plans-access-title">
      <div class="plans__condition-heading">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {MonitorCheck.map(([Tag, attributes]) => <Tag {...attributes} />)}
        </svg>
        <p class="plans__condition-eyebrow">{seoPlanNotes.webAccess.eyebrow}</p>
      </div>
      <h3 id="plans-access-title">{seoPlanNotes.webAccess.title}</h3>
      <p class="plans__condition-text">{seoPlanNotes.webAccess.text}</p>
      <p class="plans__condition-clarification">{seoPlanNotes.webAccess.clarification}</p>
    </article>
    <article class="plans__condition" aria-labelledby="plans-onpage-title">
      <div class="plans__condition-heading">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {FileSearch.map(([Tag, attributes]) => <Tag {...attributes} />)}
        </svg>
        <p class="plans__condition-eyebrow">{seoPlanNotes.onPage.eyebrow}</p>
      </div>
      <h3 id="plans-onpage-title">{seoPlanNotes.onPage.title}</h3>
      <p class="plans__condition-text">{seoPlanNotes.onPage.text}</p>
      <ul class="plans__chips" role="list">
        {seoPlanNotes.onPage.chips.map(chip => <li>{chip}</li>)}
      </ul>
    </article>
    <article class="plans__condition" aria-labelledby="plans-excluded-title">
      <div class="plans__condition-heading">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {CircleOff.map(([Tag, attributes]) => <Tag {...attributes} />)}
        </svg>
        <p class="plans__condition-eyebrow">{seoPlanNotes.excluded.eyebrow}</p>
      </div>
      <h3 id="plans-excluded-title">{seoPlanNotes.excluded.title}</h3>
      <p class="plans__condition-text">{seoPlanNotes.excluded.text}</p>
    </article>
  </div>
  <div class="plans__help">
    <p class="plans__help-title">¿No sabes qué plan elegir?</p>
    <p>Te ayudamos a encontrar el que mejor encaja con tu negocio.</p>
    <a href={helpHref.href} target="_blank" rel="noopener noreferrer">
      Pregúntanos sin compromiso <span aria-hidden="true">↗</span>
      <span class="sr-only"> por WhatsApp (se abre en una pestaña nueva)</span>
    </a>
  </div>
  <div class="plans__legal">
    <p class="plans__note">{seoPlanNotes.general}</p>
    <p class="plans__note">{seoPlanNotes.google}</p>
  </div>
</section>

<style>
  .plans {
    padding-block: 96px 64px;
  }
  .plans__heading {
    max-width: 750px;
    margin: 0 auto 40px;
    text-align: center;
  }
  .plans__label {
    margin: 0 0 18px;
    color: #59674f;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .08em;
  }
  h2 {
    margin: 0;
    font-size: clamp(30px, 3.3vw, 46px);
    font-weight: 450;
    line-height: 1.13;
    letter-spacing: -.04em;
    text-wrap: balance;
  }
  .plans__heading > p:last-child {
    margin: 24px 0 0;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.7;
  }
  .plans__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .plan {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 40px;
    border: 1px solid var(--color-line);
    border-radius: 18px;
    background: #fff;
  }
  .plan--featured {
    border-color: #b6c1aa;
    background: #e7e9e0;
  }
  .plan__badge {
    width: fit-content;
    margin: 0 0 20px;
    padding: 5px 10px;
    border: 1px solid #b6c1aa;
    border-radius: 5px;
    color: #47563e;
    font-size: 12px;
  }
  h3 {
    margin: 0;
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -.035em;
  }
  .plan__description {
    max-width: 43ch;
    min-height: 56px;
    margin: 16px 0 20px;
    color: #626158;
    font-size: 16px;
    line-height: 1.7;
  }
  .plan__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 24px;
    font-variant-numeric: tabular-nums;
  }
  .plan__price strong {
    font-size: clamp(44px, 4.5vw, 60px);
    font-weight: 450;
    line-height: 1.1;
    letter-spacing: -.04em;
  }
  .plan__price > span {
    color: #626158;
    font-size: 16px;
  }
  .plan__price small {
    margin-left: 4px;
    color: #626158;
    font-size: 12px;
  }
  .plan__features {
    padding-top: 16px;
    border-top: 1px solid #cfd4c7;
    margin-bottom: 16px;
  }
  .plan__features h4 {
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 500;
  }
  .plan__features ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .plan__features li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding-block: 4px;
    font-size: 14px;
    line-height: 1.6;
  }
  .plan__features--excluded {
    color: #626158;
  }
  .plan__features svg {
    margin-top: 2px;
    color: #607858;
  }
  .plan__features--excluded svg {
    color: #777265;
  }
  .plan__button {
    margin-top: auto;
  }
  .plan__scope {
    margin: 0 0 20px;
    color: #626158;
    font-size: 13px;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .plans__conditions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 20px;
  }
  .plans__condition {
    min-width: 0;
    padding: 18px;
    border: 1px solid #dce0d5;
    border-radius: 9px;
    background: #f1f3ed;
  }
  .plans__condition-heading {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #617858;
  }
  .plans__condition-eyebrow {
    margin: 0;
    color: #535d49;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }
  .plans__condition h3 {
    margin: 12px 0 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .plans__condition-text {
    margin: 8px 0 0;
    color: #55534d;
    font-size: 14px;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .plans__condition-clarification {
    margin: 10px 0 0;
    color: #626158;
    font-size: 12px;
    line-height: 1.5;
  }
  .plans__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .plans__chips li {
    margin: 0;
    padding: 3px 7px;
    border: 1px solid #dce0d5;
    border-radius: 4px;
    background: #f8f7f4;
    color: #47563e;
    font-size: 12px;
    line-height: 1.4;
  }
  .plan__button:focus-visible,
  .plans__help a:focus-visible {
    outline: 2px solid #47563e;
    outline-offset: 5px;
  }
  .plans__note {
    max-width: 110ch;
    margin: 0 auto;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.6;
    text-align: center;
  }
  .plans__legal {
    display: grid;
    gap: 6px;
    margin-top: 20px;
  }
  .plans__help {
    margin-top: 28px;
    text-align: center;
  }
  .plans__help p {
    margin: 6px 0 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.6;
  }
  .plans__help .plans__help-title {
    margin: 0;
    color: var(--color-ink);
    font-size: 16px;
    font-weight: 500;
  }
  .plans__help a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 4px;
    color: #47563e;
    font-size: 14px;
    line-height: 1.6;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .plans__help a:hover {
    color: var(--color-ink);
  }
  @media (max-width: 1023px) {
    .plan {
      padding: 28px;
    }
    .plans__conditions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .plans__condition:last-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 767px) {
    .plans {
      padding-block: 64px;
    }
    .plans__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .plans__conditions {
      grid-template-columns: minmax(0, 1fr);
    }
    .plan__description {
      min-height: 0;
    }
    .plan__button {
      gap: 14px;
      padding-inline: 16px;
    }
  }
</style>
