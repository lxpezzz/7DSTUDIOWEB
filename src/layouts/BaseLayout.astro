---
import "../styles/global.css";
import { site } from "../data/site";
import { brand } from "../data/brand";
import MobileStickyCta from "../components/layout/MobileStickyCta.astro";
import WhatsAppWidget from "../components/layout/WhatsAppWidget.astro";
import manropeFont from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
interface Props {
  title?: string;
  description?: string;
  structuredData?: Record<string, unknown>[];
  noindex?: boolean;
  canonicalPath?: string;
}
const {
  title = site.title,
  description = site.description,
  structuredData = [],
  noindex = false,
  canonicalPath = Astro.url.pathname,
} = Astro.props;
const canonical = new URL(canonicalPath, site.url).href;
const businessId = `${site.url}/#business`;
const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": businessId,
  name: site.name,
  url: `${site.url}/`,
  logo: new URL(brand.logo, site.url).href,
  image: new URL(brand.socialImage, site.url).href,
  description: site.description,
  telephone: site.phoneHref.replace(/^tel:/, ""),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Castellón de la Plana",
    postalCode: "12004",
    addressRegion: "Castellón",
    addressCountry: "ES",
  },
  areaServed: [
    { "@type": "City", name: "Castellón de la Plana" },
    { "@type": "AdministrativeArea", name: "Provincia de Castellón" },
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios digitales",
    itemListElement: ["Diseño web", "SEO local", "Productos QR y NFC"].map(
      (name) => ({
        "@type": "Offer",
        itemOffered: { "@type": "Service", name },
      }),
    ),
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link
      rel="preload"
      href={manropeFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
    <meta name="theme-color" content="#F8F7F4" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(brand.socialImage, site.url).href} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta
      property="og:image:alt"
      content="7DStudio — Diseño web y SEO local en Castellón"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(brand.twitterImage, site.url).href} />
    <meta name="twitter:image:alt" content="7DStudio — Diseño web y SEO local en Castellón" />
    {
      !noindex && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
        />
      )
    }
    {
      structuredData.map((data) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(data).replace(/</g, "\\u003c")}
        />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <MobileStickyCta />
    <WhatsAppWidget />
  </body>
</html>
