---
import { getHomeProjects } from "../../data/projects";
import ProjectCatalogue from "../ui/ProjectCatalogue.astro";
import SectionCta from "../ui/SectionCta.astro";

const featured = getHomeProjects();
// El CTA solo se activa cuando exista una página Astro real, sin crear rutas vacías.
const hasProjectsPage =
  Object.keys(import.meta.glob("../../pages/proyectos{,/index}.astro")).length >
  0;
---

<section
  id="proyectos"
  class="projects section"
  aria-labelledby="projects-title"
>
  <div class="container">
    <div class="projects__heading">
      <div>
        <h2 class="section-title" id="projects-title">
          Diseñamos webs que hablan por sí solas.
        </h2>
        <p class="body-copy">
          Explora algunas de nuestras propuestas y descubre cómo podemos dar
          forma a la presencia digital de tu negocio.
        </p>
      </div>
    </div>

    <ProjectCatalogue items={featured} />

    {featured.length === 0 && <div class="projects__empty"></div>}

    <SectionCta label="Quiero una web así" href="#contacto" />

    <div class="projects__footer">
      {
        hasProjectsPage ? (
          <a class="text-link" href="/proyectos/">
            Ver todos los proyectos
            <svg
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M5 19 19 5M5 5h14v14" />
            </svg>
          </a>
        ) : (
          <p class="projects__pending">
            Ver todos los proyectos
            <>
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M5 19 19 5M5 5h14v14" />
              </svg>
              <span>Próximamente</span>
            </>
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .projects {
    background: var(--color-paper);
    padding-top: 50px;
  }
  .projects__heading {
    text-align: center;
  }
  .section-title {
    max-width: 720px;
    margin-inline: auto;
  }
  .body-copy {
    max-width: 510px;
    margin: 26px auto 0;
  }
  .projects__status {
    margin: 7px 0 0;
    color: var(--color-muted);
    font-size: 10px;
    line-height: 1.6;
    letter-spacing: 0.06em;
  }

  .projects__footer {
    margin-top: 32px;
    display: flex;
    justify-content: flex-end;
    border-top: 1px solid var(--color-line);
    padding-top: 24px;
  }
  .projects__pending {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.6;
  }
  .projects__pending span {
    font-size: 11px;
    margin-left: 12px;
  }
  @media (max-width: 767px) {
    .body-copy {
      margin: 22px auto 0;
    }
    .projects__footer {
      justify-content: flex-start;
    }
    .projects__pending span {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
