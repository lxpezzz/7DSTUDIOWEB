---
import {
  webPricing,
  calculateWebQuote,
  formatWebPrice,
  webCare,
} from "../../data/webPricing";
import { Check } from "lucide";
import { site } from "../../data/site";
const initial = calculateWebQuote({
  typeId: webPricing.defaultType,
  extraIds: [],
  additionalPages: 0,
});
const extraGroups = [
  {
    id: "content",
    name: "Contenido de tu web",
    ids: ["pages", "catalogo", "gallery", "blog"],
  },
  { id: "features", name: "Funcionalidades", ids: ["idioma", "bookings"] },
  {
    id: "identity",
    name: "Imagen de tu negocio",
    ids: ["logo", "optimization-photos", "profesional-photos"],
  },
];
---

<section
  id="presupuesto"
  class="web-estimate web-section"
  aria-labelledby="web-estimate-title"
>
  <div class="container">
    <div class="web-heading">
      <p class="web-eyebrow">TU WEB, A TU MEDIDA</p>
      <h2 id="web-estimate-title"><span class="heading-emphasis">Calcula</span> cuánto podría costar tu web.</h2>
      <p>
        Precios claros para negocios de Castellón y provincia. Elige lo que
        necesitas y descubre un presupuesto orientativo al instante, sin
        permanencia y con dominio a tu nombre.
      </p>
    </div>
    <a
      class="web-estimate__early-help"
      href={site.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      >¿Tienes dudas? Te orientamos por WhatsApp <span aria-hidden="true"
        >↗</span
      ><span class="sr-only"> (se abre en una pestaña nueva)</span></a
    >
    <div class="calculator" data-web-calculator>
      <div class="calculator__options">
        <fieldset class="calculator__fieldset" data-options disabled>
          <legend>01. ¿Qué tipo de web necesitas?</legend>
          <div class="calculator__types">
            {
              webPricing.types.map((type) => (
                <label class="calculator__type">
                  <input
                    type="radio"
                    name="web-type"
                    value={type.id}
                    checked={type.id === webPricing.defaultType}
                  />
                  <span>
                    <strong>{type.name}</strong>
                    <span class="calculator__description">
                      {type.description}
                    </span>
                    <span class="calculator__type-price">
                      {type.baseCents === null
                        ? "Presupuesto personalizado"
                        : `${formatWebPrice(type.baseCents)} + IVA`}
                    </span>
                    {type.includedPages && (
                      <span class="calculator__pages">
                        {type.includedPages}{" "}
                        {type.includedPages === 1
                          ? "página incluida"
                          : "páginas incluidas"}
                      </span>
                    )}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <details class="calculator__included">
          <summary>
            <span data-included-summary>✓ Diseño adaptable · Formulario de contacto · SEO básico</span>
            <span class="calculator__included-action">Ver todo lo incluido</span>
          </summary>
          <p class="calculator__included-title" data-included-title>Incluido en el precio base</p>
          <ul data-included>
            {initial.type.included.map((item) => <li>{item}</li>)}
          </ul>
        </details>
        <section class="calculator__care" aria-labelledby="web-care-title">
          <h3 id="web-care-title">Incluido con tu página web</h3>
          <ul role="list">
            {
              [webCare.hosting, webCare.maintenance].map(service => (
                <li>
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    {Check.map(([Tag, attributes]) => <Tag {...attributes} />)}
                  </svg>
                  <div>
                    <strong>{service.title}</strong>
                    <p>{service.description}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <p>{webCare.maintenance.requirement}</p>
          <p>{webCare.separate}</p>
        </section>
        <fieldset class="calculator__fieldset" data-options disabled>
          <legend>02. Añade solo lo que necesitas</legend>
          <p class="calculator__hint" id="web-extras-hint">
            Los extras se suman una sola vez. Páginas adicionales y blog están
            disponibles con la web de varias páginas.
          </p>
          {
            extraGroups.map((group, index) => (
              <details
                class="calculator__extra-group"
                name="web-extra-groups"
                data-extra-group
                open={index === 0}
              >
                <summary>
                  <span>{group.name}</span>
                  <span class="calculator__group-count" data-group-count>0 seleccionados</span>
                </summary>
                <div class="calculator__extras">
                  {webPricing.extras
                    .filter((extra) => group.ids.includes(extra.id))
                    .map((extra) => {
                      const available = (
                        extra.compatibleWith as readonly string[]
                      ).includes(initial.type.id);
                      const availability = `Disponible con ${extra.compatibleWith
                        .map(id => webPricing.types.find(type => type.id === id)!.name.toLocaleLowerCase('es'))
                        .join(' o ')}.`;
                      return (
                        <div
                          class="calculator__extra"
                          data-extra-id={extra.id}
                          data-available={String(available)}
                        >
                          <div class="calculator__extra-row">
                            {extra.quantity ? (
                              <label for="web-extra-pages">
                                <strong>{extra.name}</strong>
                              </label>
                            ) : (
                              <label>
                                <input
                                  type="checkbox"
                                  name="web-extra"
                                  value={extra.id}
                                  disabled={!available}
                                  aria-describedby={`extra-${extra.id}-availability`}
                                />
                                <strong>{extra.name}</strong>
                              </label>
                            )}
                            <span class="calculator__extra-price">
                              + {formatWebPrice(extra.unitCents)}
                              {extra.quantity ? " / página" : ""}
                            </span>
                          </div>
                          <div class="calculator__extra-controls">
                            {extra.quantity && (
                              <input
                                id="web-extra-pages"
                                type="number"
                                name="additional-pages"
                                min="0"
                                max={webPricing.maxAdditionalPages}
                                step="1"
                                value="0"
                                disabled={!available}
                                aria-describedby={`web-extras-hint extra-${extra.id}-availability`}
                              />
                            )}
                            <details class="calculator__extra-details">
                              <summary>
                                Ver detalles
                                <span class="sr-only"> de {extra.name}</span>
                              </summary>
                              <p>{extra.description}</p>
                            </details>
                          </div>
                          <p
                            class="calculator__availability"
                            data-extra-availability
                            id={`extra-${extra.id}-availability`}
                            hidden={available}
                          >
                            {availability}
                          </p>
                        </div>
                      );
                    })}
                </div>
              </details>
            ))
          }
          <p
            class="calculator__change"
            data-compatibility
            role="status"
            aria-live="polite"
          >
          </p>
        </fieldset>
      </div>
      <aside
        id="resumen-web"
        class="calculator__summary"
        aria-labelledby="web-summary-title"
      >
        <p class="web-eyebrow">SIN COMPROMISO</p>
        <h3 id="web-summary-title">Tu presupuesto orientativo</h3>
        <p class="calculator__selected" data-selected-type>
          {initial.type.name}
        </p>
        <dl class="calculator__lines" data-quote-lines>
          <div>
            <dt>Precio base</dt><dd>
              {formatWebPrice(initial.type.baseCents!)}
            </dd>
          </div>
        </dl>
        <div class="calculator__total" aria-live="polite" aria-atomic="true">
          <span>Precio inicial orientativo · desarrollo y extras</span>
          <output data-quote-total>{formatWebPrice(initial.totalCents!)}</output
          >
          <small data-quote-tax>IVA no incluido</small>
        </div>
        <p class="calculator__custom" data-custom-message hidden>
          Cuéntanos tu proyecto y te prepararemos un presupuesto a medida.
        </p>
        <div class="calculator__recurring">
          <strong>Mantenimiento · cuota aparte</strong>
          <p>
            {webCare.maintenance.title}. {webCare.maintenance.description}
          </p>
          <p>
            Obligatorio mientras tu web siga alojada y gestionada por {site.name}.
          </p>
        </div>
        <a
          class="button calculator__request"
          href="#contacto-web"
          data-request-quote
          >Solicitar este presupuesto <span aria-hidden="true">↗</span></a
        >
        <noscript
          ><p class="calculator__hint">
            Activa JavaScript para calcular las opciones. También puedes
            contarnos lo que necesitas en el formulario.
          </p></noscript
        >
        <p class="calculator__footnote">{webPricing.conditions.estimate}</p>
      </aside>
    </div>
    <div class="web-estimate__conditions">
      <p>{webPricing.conditions.notIncluded}</p>
      <p>{webPricing.conditions.scope}</p>
    </div>
  </div>
</section>

<style>
  .web-estimate {
    background: var(--web-surface);
    border-block: 1px solid var(--web-border);
  }
  .web-estimate__early-help {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-bottom: 24px;
    color: var(--web-accent-text);
    font-size: 14px;
    line-height: 1.6;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .calculator__extra-group {
    border-top: 1px solid var(--web-border);
  }
  .calculator__extra-group:last-of-type {
    border-bottom: 1px solid var(--web-border);
  }
  .calculator__extra-group > summary {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 60px;
    padding-block: 14px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    cursor: pointer;
    list-style: none;
  }
  .calculator__group-count {
    flex-shrink: 0;
    margin-left: auto;
    color: var(--web-muted);
    font-size: 11px;
    font-weight: 400;
  }
  .calculator__extra-group > summary::after,
  .calculator__included > summary::after {
    content: '';
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg);
  }
  .calculator__extra-group[open] > summary::after,
  .calculator__included[open] > summary::after {
    transform: rotate(225deg);
  }
  .calculator summary::-webkit-details-marker {
    display: none;
  }
  .calculator {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: start;
    gap: 36px;
  }
  .calculator__options {
    min-width: 0;
  }
  .calculator__fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .calculator__fieldset legend {
    margin-bottom: 18px;
    padding: 0;
    font-size: 18px;
    font-weight: 600;
  }
  .calculator__types {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    grid-auto-rows: 1fr;
  }
  .calculator__type {
    position: relative;
    display: block;
    min-width: 0;
    padding: 14px 16px;
    border: 1px solid var(--web-border);
    border-radius: 10px;
    background: #fff;
    cursor: pointer;
  }
  .calculator__type > span {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .calculator__type > input[type="radio"] {
    position: absolute;
    top: 16px;
    right: 14px;
    margin: 0;
  }
  .calculator__type:has(input:checked) {
    border-color: var(--web-accent);
    background: var(--web-beige);
  }
  .calculator__type:has(input:focus-visible) {
    outline: 2px solid var(--web-accent);
    outline-offset: 3px;
  }
  .calculator input[type="radio"],
  .calculator input[type="checkbox"] {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin: 2px 0 0;
    accent-color: var(--web-accent);
  }
  .calculator__type strong {
    display: block;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    padding-right: 28px;
  }
  .calculator__description {
    display: block;
    margin-top: 6px;
    color: var(--web-muted);
    font-size: 13px;
    line-height: 1.5;
  }
  .calculator__type-price {
    display: block;
    margin-top: auto;
    padding-top: 10px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
  }
  .calculator__pages {
    display: block;
    margin-top: 4px;
    color: var(--web-muted);
    font-size: 12px;
    line-height: 1.5;
  }
  .calculator__included {
    margin-block: 20px 28px;
    border-block: 1px solid var(--web-border);
  }
  .calculator__included > summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding-block: 16px;
    cursor: pointer;
    list-style: none;
  }
  .calculator__included > summary > span:first-child {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.7;
  }
  .calculator__included-action {
    grid-column: 1;
    color: var(--web-accent-text);
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .calculator__included > summary::after {
    grid-column: 2;
    grid-row: 1 / 3;
  }
  .calculator__included-title {
    margin: 4px 0 10px;
    font-size: 13px;
    font-weight: 600;
  }
  .calculator__included ul {
    margin: 0 0 18px;
    padding-left: 18px;
    color: var(--web-muted);
    font-size: 13px;
    line-height: 1.8;
  }
  .calculator__hint {
    margin: 0 0 14px;
    color: var(--web-muted);
    font-size: 13px;
    line-height: 1.6;
  }
  .calculator__extras {
    padding-bottom: 8px;
  }
  .calculator__extra {
    min-width: 0;
    padding-block: 10px;
    border-top: 1px solid var(--web-border);
  }
  .calculator__extra-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 44px;
  }
  .calculator__extra-row > label {
    display: flex;
    align-items: start;
    gap: 10px;
    min-width: 0;
    padding-block: 10px;
    cursor: pointer;
  }
  .calculator__extra-controls {
    display: flex;
    align-items: start;
    gap: 16px;
    padding-left: 28px;
  }
  .calculator__extra[data-extra-id="pages"] .calculator__extra-controls {
    padding-left: 0;
  }
  .calculator__extra-details {
    flex: 1;
    min-width: 0;
  }
  .calculator__extra-details summary {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--web-accent-text);
    font-size: 12px;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    list-style: none;
  }
  .calculator__extra-details[open] summary {
    font-weight: 600;
  }
  .calculator__extra-details p {
    margin: 4px 0 8px;
    color: var(--web-muted);
    font-size: 12px;
    line-height: 1.65;
  }
  .calculator__extra strong {
    display: block;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
  }
  .calculator__availability {
    margin: 4px 0 6px;
    color: var(--web-muted);
    font-size: 12px;
    line-height: 1.6;
  }
  .calculator__extra[data-available="false"] strong,
  .calculator__extra[data-available="false"] .calculator__extra-price {
    color: var(--web-muted);
  }
  .calculator__extra:has(input:checked) {
    border-color: var(--web-accent);
  }
  .calculator input[type="number"] {
    width: 66px;
    min-height: 44px;
    padding: 8px;
    border: 1px solid var(--web-border);
    border-radius: 5px;
    background: #fff;
    color: var(--web-ink);
    font: inherit;
  }
  .calculator__extra-price {
    color: var(--web-accent-text);
    font-size: 13px;
    line-height: 1.5;
  }
  .calculator__change {
    margin: 12px 0 0;
    color: var(--web-accent);
    font-size: 13px;
    line-height: 1.6;
  }
  .calculator__change:empty {
    display: none;
  }
  .calculator__summary {
    scroll-margin-top: 72px;
    position: sticky;
    top: calc(var(--header-height) + 24px);
    padding: 28px;
    border: 1px solid #c8aa9d;
    border-top: 3px solid #b88470;
    border-radius: 12px;
    background: #fff;
  }
  .calculator__summary h3 {
    margin: 0;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }
  .calculator__selected {
    margin: 18px 0 12px;
    color: var(--web-accent);
    font-size: 14px;
    font-weight: 600;
  }
  .calculator__lines {
    margin: 0;
    font-size: 13px;
  }
  /* El desglose se reconstruye en el navegador, sin atributos de scope de Astro. */
  .calculator__lines > :global(div) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 8px;
  }
  .calculator__lines :global(dd) {
    flex-shrink: 0;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .calculator__total {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--web-border);
  }
  .calculator__total > span,
  .calculator__total small {
    display: block;
    color: var(--web-muted);
    font-size: 13px;
  }
  .calculator__total output {
    display: block;
    margin-block: 8px;
    font-size: clamp(32px, 3.5vw, 48px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .calculator__custom {
    margin: 18px 0 0;
    font-size: 15px;
    line-height: 1.6;
  }
  .calculator__recurring {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--web-border);
    font-size: 14px;
    line-height: 1.6;
  }
  .calculator__recurring strong {
    font-weight: 600;
  }
  .calculator__recurring p {
    margin: 6px 0 0;
    color: var(--web-muted);
  }
  .calculator__request {
    width: 100%;
    margin-top: 24px;
    gap: 16px;
  }
  .calculator__care {
    margin-block: 24px 28px;
  }
  .calculator__care h3 {
    margin: 0 0 12px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
  }
  .calculator__care ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .calculator__care li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 10px;
    padding-block: 12px;
    border-top: 1px solid var(--web-border);
  }
  .calculator__care li:last-child {
    border-bottom: 1px solid var(--web-border);
  }
  .calculator__care svg {
    margin-top: 2px;
    color: var(--web-accent-text);
  }
  .calculator__care strong {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
  }
  .calculator__care p {
    margin: 8px 0 0;
    color: var(--web-muted);
    font-size: 14px;
    line-height: 1.6;
  }
  .calculator__care li p {
    margin-top: 4px;
  }
  .calculator__footnote {
    margin: 16px 0 0;
    color: var(--web-muted);
    font-size: 12px;
    line-height: 1.6;
  }
  .web-estimate__conditions {
    max-width: 95ch;
    margin-top: 24px;
    color: var(--web-muted);
    font-size: 13px;
    line-height: 1.7;
  }
  .web-estimate__conditions p {
    margin: 8px 0 0;
  }
  @media (max-width: 1023px) {
    .calculator input {
      scroll-margin-top: 88px;
    }
    .calculator {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .calculator__summary {
      position: static;
    }
  }
  @media (max-width: 599px) {
    .calculator__types {
      grid-template-columns: minmax(0, 1fr);
    }
    .calculator__extra-details summary {
      min-height: 44px;
    }
    .calculator__summary {
      padding: 22px;
    }
  }
</style>

<script>
  import { initWebCalculator } from "../../scripts/web-calculator";
  const calculator = document.querySelector<HTMLElement>(
    "[data-web-calculator]",
  );
  if (calculator) initWebCalculator(calculator);
</script>
