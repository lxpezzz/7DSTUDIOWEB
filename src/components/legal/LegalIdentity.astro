---
import { legal, pendingValue } from '../../data/legal';
import { site } from '../../data/site';
---
<dl class="legal-identity">
  <div><dt>Nombre comercial</dt><dd>{site.name}</dd></div>
  <div><dt>Titular / razón social</dt><dd>{pendingValue(legal.entityName)}</dd></div>
  <div><dt>NIF / CIF</dt><dd>{pendingValue(legal.taxId)}</dd></div>
  <div><dt>Domicilio completo</dt><dd>{pendingValue(legal.address)}</dd></div>
  <div><dt>Correo electrónico</dt><dd>{legal.email ? <a href={`mailto:${legal.email}`}>{legal.email}</a> : '… (pendiente de confirmar)'}</dd></div>
  <div><dt>Teléfono</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
  <div><dt>Sitio web</dt><dd><a href={site.url}>7dstudio.es</a></dd></div>
  <div><dt>Datos registrales, si procede</dt><dd>{pendingValue(legal.registry)}</dd></div>
  <div><dt>Autorización o colegiación, si procede</dt><dd>{pendingValue(legal.authorizations)}</dd></div>
</dl>
<style>
  .legal-identity { margin: 24px 0; }
  .legal-identity > div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 16px; padding-block: 12px; border-bottom: 1px solid var(--color-line); }
  dt { font-weight: 550; }
  dd { margin: 0; overflow-wrap: anywhere; }
  a { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 599px) { .legal-identity > div { grid-template-columns: minmax(0, 1fr); gap: 4px; } }
</style>
