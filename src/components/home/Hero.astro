---
import { heroScene } from "../../data/hero-scene";
const maskId = `screen-opening-${crypto.randomUUID()}`;
---

<section class="cinematic-hero" aria-labelledby="hero-title">
  <div class="cinematic-hero__stage">
    <div class="cinematic-hero__photo" aria-hidden="true">
      <img
        src={heroScene.image}
        width={heroScene.width}
        height={heroScene.height}
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="cinematic-hero__projection" aria-hidden="true" inert></div>
    <div class="cinematic-hero__poster" aria-hidden="true" inert hidden></div>
    <div class="cinematic-hero__foreground" aria-hidden="true">
      <svg
        viewBox={`0 0 ${heroScene.width} ${heroScene.height}`}
        preserveAspectRatio="xMidYMid slice"
        focusable="false"
      >
        <defs>
          <mask
            id={maskId}
            maskUnits="userSpaceOnUse"
            x="0"
            y="0"
            width={heroScene.width}
            height={heroScene.height}
          >
            <rect width={heroScene.width} height={heroScene.height} fill="white"
            ></rect>
            <polygon points={heroScene.opening} fill="black"></polygon>
          </mask>
        </defs>
        <image
          href={heroScene.image}
          width={heroScene.width}
          height={heroScene.height}
          mask={`url(#${maskId})`}
        />
      </svg>
    </div>
    <div class="cinematic-hero__interaction" hidden></div>
    <div class="cinematic-hero__outside">
      <div class="cinematic-hero__copy">
        <p class="cinematic-hero__eyebrow">Estudio web independiente</p>
        <h1 id="hero-title">
          Tu negocio,<br />mejor presentado.
        </h1>
        <p class="cinematic-hero__subtitle">
          Y más fácil de <span class="cinematic-hero__underline">encontrar.</span>
        </p>
        <p class="cinematic-hero__description">
          Diseño web, SEO local y soluciones digitales para conectar tu negocio
          con tus clientes.
        </p>
        <div class="cinematic-hero__actions">
          <a class="button cinematic-hero__cta-primary" href="#contacto"
            >Cuéntanos tu proyecto <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
            ></a
          >
          <a class="cinematic-hero__cta-secondary" href="#proyectos"
            >Ver nuestros trabajos <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
            ></a
          >
        </div>
      </div>
      <a class="cinematic-hero__scroll" href="#servicios">
        <span class="cinematic-hero__scroll-line" aria-hidden="true"></span>
        <span>DESLIZA HACIA ABAJO</span>
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6"></path></svg
        >
      </a>
    </div>
    <div class="cinematic-hero__debug" aria-hidden="true" hidden></div>
  </div>
</section>

<script>
  import { initCinematicHero } from "../../scripts/cinematic-hero";
  initCinematicHero();
</script>

<style>
  .cinematic-hero {
    position: relative;
    z-index: 1;
  }
  .cinematic-hero__stage {
    position: relative;
    height: 100svh;
    min-height: 680px;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-paper);
  }
  .cinematic-hero__photo,
  .cinematic-hero__foreground {
    position: absolute;
    inset: 0;
    transform-origin: 0 0;
    pointer-events: none;
  }
  .cinematic-hero__interaction {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    overflow: hidden;
    transform-origin: 0 0;
    pointer-events: none;
  }
  .cinematic-hero__interaction :global(a) {
    position: absolute;
    display: block;
    pointer-events: auto;
    cursor: pointer;
  }
  .cinematic-hero__interaction :global(a:focus-visible) {
    outline: 3px solid #171717;
    outline-offset: -4px;
  }
  .cinematic-hero__photo img,
  .cinematic-hero__foreground svg {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 50%;
  }
  .cinematic-hero__foreground {
    z-index: 2;
    display: none;
    pointer-events: none;
  }
  .cinematic-hero__projection {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    overflow: hidden;
    transform-origin: 0 0;
    background: var(--color-paper);
    pointer-events: none;
    visibility: hidden;
  }
  /* Capa estática dedicada proyectada a ~0.35x del viewport (casi 1:1 con la pantalla
     del portátil) para evitar el submuestreo bilineal de matrix3d() en p=0. */
  .cinematic-hero__poster {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    overflow: hidden;
    transform-origin: 0 0;
    background: #f4f1eb;
    pointer-events: none;
  }
  .cinematic-hero__poster :global(img) {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    display: block;
    max-width: none;
    pointer-events: none;
  }
  /* Sobremuestreo del HTML sin cambiar su composición ni los puntos proyectados.
     Se fija el ancho lógico al medir, nunca durante los frames del zoom. */
  .cinematic-hero__projection :global(.cinematic-hero__replica) {
    transform-origin: 0 0;
  }
  .cinematic-hero__projection :global(header.cinematic-hero__replica-header) {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    pointer-events: none;
  }
  .cinematic-hero__projection :global(header.cinematic-hero__replica-header .nav > span) {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 44px;
    font-size: 15px;
    white-space: nowrap;
  }
  @media (max-resolution: 1.49dppx) {
    @supports (zoom: 2) {
      .cinematic-hero:not(.cinematic-native-resolution) .cinematic-hero__projection :global(.cinematic-hero__replica) {
        zoom: 2;
        transform: scale(.5);
      }
    }
  }
  .cinematic-hero__outside {
    position: relative;
    z-index: 3;
    height: 100%;
    pointer-events: none;
  }
  .cinematic-hero__copy,
  .cinematic-hero__scroll {
    pointer-events: auto;
  }
  .cinematic-hero__copy {
    position: absolute;
    top: clamp(calc(var(--header-height) + 12px), 12.5svh, 136px);
    left: var(--gutter);
    width: min(29%, 440px);
  }
  .cinematic-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 clamp(8px, 1.3svh, 14px);
    color: var(--color-muted);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .cinematic-hero__eyebrow::before {
    content: "";
    display: block;
    width: 24px;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
    flex-shrink: 0;
  }
  h1 {
    margin: 0;
    width: max-content;
    max-width: calc(100vw - var(--gutter) * 2);
    color: var(--color-ink);
    font-size: clamp(36px, min(4.6vw, 7.8svh), 84px);
    font-weight: 550;
    line-height: 0.96;
    letter-spacing: -0.048em;
  }
  .cinematic-hero__subtitle {
    margin: clamp(8px, 1.5svh, 16px) 0 0;
    color: #66615b;
    font-size: clamp(24px, min(3.1vw, 4.9svh), 52px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.032em;
  }
  .cinematic-hero__underline {
    text-decoration-line: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.16em;
    text-decoration-color: currentColor;
    text-decoration-skip-ink: auto;
  }
  .cinematic-hero__description {
    max-width: 28ch;
    margin: clamp(12px, 2svh, 22px) 0 clamp(14px, 2.6svh, 28px);
    color: var(--color-muted);
    font-size: clamp(15px, min(1.55vw, 2.4svh), 24px);
    line-height: 1.48;
  }
  .cinematic-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(10px, 1.4svh, 14px) clamp(16px, 2vw, 26px);
  }
  .cinematic-hero__cta-primary {
    min-height: clamp(46px, 5.8svh, 62px);
    padding: clamp(11px, 1.6svh, 18px) clamp(18px, 2vw, 30px);
    gap: clamp(12px, 1.4vw, 20px);
    font-size: clamp(15px, min(1.35vw, 2.1svh), 20px);
    white-space: nowrap;
  }
  .cinematic-hero__cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    color: var(--color-ink);
    font-size: clamp(15px, min(1.35vw, 2.1svh), 20px);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-color: rgba(23, 23, 23, 0.35);
    transition: text-decoration-color 0.25s ease, color 0.25s ease;
  }
  .cinematic-hero__cta-secondary svg {
    transition: transform 0.3s ease;
  }
  .cinematic-hero__cta-secondary:hover {
    text-decoration-color: currentColor;
  }
  .cinematic-hero__cta-secondary:hover svg,
  .cinematic-hero__cta-secondary:focus-visible svg {
    transform: translate(3px, -3px);
  }
  .cinematic-hero__scroll {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(20px, 5.5svh, 72px);
    width: max-content;
    margin-inline: auto;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    opacity: 0.96;
    transition: opacity 0.25s ease;
  }
  .cinematic-hero__scroll:hover {
    opacity: 1;
  }
  .cinematic-hero__scroll svg {
    transition: transform 0.25s ease;
  }
  .cinematic-hero__scroll:hover svg,
  .cinematic-hero__scroll:focus-visible svg {
    transform: translateY(3px);
  }
  .cinematic-hero__scroll-line {
    display: block;
    width: 1px;
    height: 22px;
    background: currentColor;
    opacity: 0.8;
  }
  @keyframes hero-reveal {
    from {
      opacity: 0.01;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cinematic-hero__eyebrow {
      animation: hero-reveal 0.45s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }
    h1 {
      animation: hero-reveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.06s backwards;
    }
    .cinematic-hero__subtitle {
      animation: hero-reveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.12s backwards;
    }
    .cinematic-hero__description {
      animation: hero-reveal 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.18s backwards;
    }
    .cinematic-hero__actions {
      animation: hero-reveal 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.22s backwards;
    }
    .cinematic-hero__scroll {
      animation: hero-reveal 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.28s backwards;
    }
  }
  .cinematic-hero__debug {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
  }
  .cinematic-hero.cinematic-projected .cinematic-hero__projection {
    visibility: visible;
  }
  .cinematic-hero.cinematic-projected .cinematic-hero__foreground {
    display: block;
  }
  /* Las reglas de presentación no deben anular el atributo hidden del traspaso. */
  .cinematic-hero [hidden] {
    display: none !important;
  }
  .cinematic-hero.cinematic-ready .cinematic-hero__stage {
    min-height: 0;
  }
  .cinematic-hero.cinematic-ready:not(.cinematic-complete) .cinematic-hero__photo,
  .cinematic-hero.cinematic-ready:not(.cinematic-complete) .cinematic-hero__foreground,
  .cinematic-hero.cinematic-ready:not(.cinematic-complete) .cinematic-hero__projection {
    will-change: transform;
  }
  .cinematic-hero.cinematic-ready:not(.cinematic-complete) .cinematic-hero__poster {
    will-change: transform, opacity;
  }
  .cinematic-hero.cinematic-complete .cinematic-hero__stage {
    visibility: hidden;
  }
  /* El pin-spacer conserva su altura, pero no debe interceptar la sección real. */
  .cinematic-hero.cinematic-complete {
    visibility: hidden;
    pointer-events: none;
  }
  :global(.cinematic-ready ~ .services-surface) {
    margin-top: -100svh;
  }
  /* El padding interno de Servicios ya deja sus títulos bajo el header fijo.
     Cancelar la compensación global para no aterrizar antes de liberar el pin. */
  :global(.cinematic-ready ~ .services-surface #servicios) {
    scroll-margin-top: calc(-1 * (var(--header-height) + 24px));
  }
  @media (min-width: 768px) and (max-width: 1279px) and (min-aspect-ratio: 1/1) {
    .cinematic-hero__photo img {
      object-position: 0% 50%;
    }
  }
  @media (min-width: 768px) and (max-aspect-ratio: 1/1) {
    .cinematic-hero__photo,
    .cinematic-hero__foreground {
      top: 180px;
    }
    .cinematic-hero__copy {
      top: 102px;
      width: 68%;
      max-width: 520px;
    }
    .cinematic-hero__eyebrow {
      margin-bottom: 10px;
      font-size: 10px;
    }
    h1 {
      width: auto;
      font-size: clamp(34px, 4.4vw, 46px);
    }
    .cinematic-hero__subtitle {
      margin-top: 8px;
      font-size: clamp(19px, 2.4vw, 26px);
    }
    .cinematic-hero__description {
      margin: 12px 0 16px;
      font-size: 14px;
      line-height: 1.5;
    }
    .cinematic-hero__cta-primary {
      min-height: 46px;
      padding: 12px 20px;
    }
    .cinematic-hero__scroll {
      bottom: calc(var(--mobile-nav-height) + 16px);
      color: var(--color-ink);
      background: var(--color-paper);
      padding-inline: 12px;
    }
  }
  @media (max-width: 767px) {
    .cinematic-hero__stage {
      height: auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
      padding-top: var(--header-height);
    }
    .cinematic-hero__outside {
      display: contents;
    }
    .cinematic-hero__copy {
      position: static;
      order: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      width: auto;
      max-width: none;
      margin: 32px var(--gutter) 28px;
    }
    .cinematic-hero__eyebrow {
      margin-bottom: 16px;
      font-size: 10px;
    }
    h1 {
      width: auto;
      margin-inline: auto;
      font-size: clamp(40px, 9.6vw, 56px);
      line-height: 1.02;
      max-width: 12ch;
    }
    .cinematic-hero__subtitle {
      margin: 12px auto 0;
      font-size: clamp(22px, 5.4vw, 30px);
      max-width: 16ch;
    }
    .cinematic-hero__description {
      margin: 20px auto 24px;
      font-size: 15px;
    }
    .cinematic-hero__actions {
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }
    .cinematic-hero__photo {
      display: none;
    }
    .cinematic-hero.cinematic-projected .cinematic-hero__foreground,
    .cinematic-hero__projection,
    .cinematic-hero__poster {
      display: none;
    }
    .cinematic-hero__scroll {
      position: static;
      order: 3;

      /* Centrado horizontal */
      align-self: center;
      justify-content: center;
      margin: 4px auto 20px;

      /* Distribución del texto y la línea */
      display: inline-flex;
      align-items: center;
      gap: 12px;

      /* Estética */
      width: max-content;
      max-width: 100%;
      color: var(--color-ink);
      white-space: nowrap;

      /* Eliminar desplazamientos */
      transform: none;
    }
  }
</style>
