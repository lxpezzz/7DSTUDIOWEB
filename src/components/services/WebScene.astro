---
import { Image } from 'astro:assets';
import valero from '../../images/projects/valero.webp';
---

<div class="web-scene" aria-hidden="true">
  <Image
    src={valero}
    width={1280}
    widths={[640, 960, 1280]}
    sizes="(max-width: 1023px) 92vw, 50vw"
    format="webp"
    quality={86}
    alt=""
    loading="eager"
    decoding="async"
  />
</div>

<style>
  .web-scene {
    position: relative;
    height: 100%;
    min-height: clamp(235px, 20vw, 285px);
    overflow: hidden;
    background: #2b2723;
  }
  .web-scene img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .web-scene img {
      transition: transform 600ms cubic-bezier(.16, 1, .3, 1);
    }
    :global(.service-card:hover) .web-scene img {
      transform: scale(1.028);
    }
  }
  @media (max-width: 1023px) {
    .web-scene {
      height: auto;
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
  }
</style>
