---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WebProjects from '../components/web-design/WebProjects.astro';
import WebCalculator from '../components/web-design/WebCalculator.astro';
import WebContact from '../components/web-design/WebContact.astro';
import huella from '../images/projects/huella.webp';
import { ShieldCheck, LayoutTemplate, MousePointerClick, Smartphone, Check, Minus } from 'lucide';
import { site } from '../data/site';
import { webPricing, formatWebPrice } from '../data/webPricing';
import '../styles/web-design.css';

const benefits = [
  { title: 'Transmite confianza', text: 'Una presentación cuidada ayuda a que tus clientes conozcan mejor tu negocio.', icon: ShieldCheck },
  { title: 'Explica tus servicios', text: 'Toda la información importante, organizada para que sea fácil de entender.', icon: LayoutTemplate },
  { title: 'Facilita el contacto', text: 'WhatsApp, teléfono y formularios accesibles para que puedan hablar contigo.', icon: MousePointerClick },
  { title: 'Se adapta a cualquier pantalla', text: 'Tu negocio se verá correctamente en móvil, tablet y ordenador.', icon: Smartphone },
];
const process = [
  { title: 'Conocemos tu negocio', text: 'Nos explicas qué haces, qué necesitas y qué quieres transmitir.' },
  { title: 'Diseñamos tu web', text: 'Organizamos la información y preparamos un diseño adaptado a tu negocio.' },
  { title: 'La ponemos en marcha', text: 'Revisamos su funcionamiento, la adaptamos a diferentes pantallas y la publicamos.' },
];
const situations = [
  { id: 'scattered', title: 'Información dispersa', label: 'CUESTA CONOCERTE', points: ['Servicios difíciles de encontrar.', 'Información repartida entre diferentes plataformas.', 'Contacto poco visible.', 'Imagen del negocio poco coherente.'], icon: Minus },
  { id: 'clear', title: 'Una web bien diseñada', label: 'TODO EN SU SITIO', points: ['Servicios organizados.', 'Información clara.', 'Diseño profesional.', 'Acceso directo al contacto.', 'Buena experiencia en móvil.'], icon: Check },
];
const faqs = [
  { question: '¿Qué necesito para tener una página web?', answer: 'Empezamos con información sobre tu negocio, tus servicios y las imágenes o materiales que tengas. Definimos contigo qué falta y qué alcance necesita el proyecto.' },
  { question: '¿Cuánto cuesta crear una web para mi negocio?', answer: `La referencia para una web de una página es de ${formatWebPrice(webPricing.types[0].baseCents!)} + IVA. La calculadora permite explorar otras opciones; las tarifas de corporativa y extras son provisionales. Confirmamos el presupuesto después de revisar lo que necesitas.` },
  { question: '¿Tengo que pagar todos los meses?', answer: 'El desarrollo de la web se presupuesta como proyecto. Dominio, hosting, mantenimiento y servicios SEO mensuales se valoran por separado; no están incluidos automáticamente. Te explicamos los conceptos antes de contratar.' },
  { question: '¿Qué diferencia hay entre una web de una página y una web corporativa?', answer: 'La primera reúne la información en una única página. Una corporativa reparte servicios, empresa y contacto en varias páginas. La elección depende del contenido que necesites presentar.' },
  { question: '¿Mi web funcionará en el móvil?', answer: 'Sí. Adaptamos el diseño a móvil, tablet y ordenador, y revisamos la navegación y las formas de contacto en diferentes tamaños de pantalla.' },
  { question: '¿Podré solicitar cambios después?', answer: 'Sí. Podemos valorar cambios o ampliaciones cuando los necesites. Su alcance y presupuesto se acuerdan contigo; no implican mantenimiento ni modificaciones ilimitadas.' },
  { question: '¿Mi página aparecerá en Google?', answer: 'Preparamos la web para que los buscadores puedan entenderla. La indexación y el posicionamiento dependen de varios factores: no garantizamos posiciones. Si necesitas seguimiento, podemos valorar el servicio de SEO local.' },
  { question: '¿Qué ocurre si no sé qué tipo de web necesito?', answer: 'No necesitas llegar con todo decidido. Cuéntanos qué hace tu negocio y qué te gustaría conseguir; te ayudamos a elegir una opción adecuada antes de cerrar el presupuesto.' },
];
const structuredData = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Diseño web', item: `${site.url}/diseno-web/` },
  ],
}];
---

<BaseLayout title="Diseño web en Castellón para negocios | 7D Studio" description="Páginas web profesionales para autónomos, pequeños negocios y pymes. Explora nuestros proyectos y calcula un presupuesto orientativo para tu web." structuredData={structuredData}>
  <Header />
  <main id="contenido" class="web-page">
    <section class="web-hero container" aria-labelledby="web-title">
      <nav class="web-breadcrumb" aria-label="Ruta de navegación"><a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Diseño web</span></nav>
      <div class="web-hero__layout">
        <div class="web-hero__copy">
          <p class="web-eyebrow">DISEÑO WEB / 7D STUDIO</p>
          <h1 id="web-title">Tu negocio merece una web que <span>lo represente de verdad.</span></h1>
          <p class="web-hero__description">Diseñamos páginas web profesionales para que tus clientes entiendan qué haces, confíen en tu negocio y puedan contactar contigo fácilmente.</p>
          <a class="button" href="#presupuesto">Calcula tu presupuesto <span aria-hidden="true">↗</span></a>
          <a class="web-text-link web-hero__secondary" href="#proyectos">Ver nuestros proyectos <span aria-hidden="true">↓</span></a>
        </div>
        <figure class="web-hero__preview">
          <div class="web-browser">
            <div class="web-browser__bar"><span class="web-browser__dots" aria-hidden="true"><i></i><i></i><i></i></span><span>Huella · demo de diseño</span><span aria-hidden="true">↗</span></div>
            <Image src={huella} width={960} widths={[480, 800, 1200]} sizes="(max-width: 959px) 90vw, 44vw" format="webp" quality={85} alt="Captura real de la demo Huella, una propuesta de web para peluquería canina" loading="eager" fetchpriority="high" />
          </div>
          <figcaption>Una forma de presentar un negocio. Huella es una demo, no un cliente real.</figcaption>
        </figure>
      </div>
    </section>

    <section class="web-problem web-section container" aria-labelledby="web-problem-title">
      <div class="web-heading"><p class="web-eyebrow">LO QUE VE TU CLIENTE</p><h2 id="web-problem-title">Tu negocio puede ser excelente.<br />Pero también tiene que parecerlo online.</h2><p>Cuando alguien descubre tu empresa, quiere saber qué haces, qué servicios ofreces y cómo contactar contigo. Si esa información no está clara, puede seguir buscando otras opciones.</p></div>
      <div class="web-comparison">
        {situations.map(situation => <article class:list={['web-situation', `web-situation--${situation.id}`]}>
          <p class="web-eyebrow">{situation.label}</p><h3>{situation.title}</h3>
          <div class:list={['web-interface', `web-interface--${situation.id}`]} aria-hidden="true">
            {situation.id === 'scattered' ? <><span>Servicios…</span><span>Redes sociales</span><span>¿Cómo contacto?</span><span>Horarios en otro sitio</span></> : <><div class="web-interface__nav"><b>Tu negocio</b><span>Servicios · Contacto</span></div><div class="web-interface__body"><div><strong>Lo que haces.<br />Claro desde el principio.</strong><span class="web-interface__cta">Hablemos de tu negocio ↗</span></div><div class="web-interface__visual"><span></span><span></span><span></span></div></div></>}
          </div>
          <ul role="list">{situation.points.map(point => <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{situation.icon.map(([Tag, attributes]) => <Tag {...attributes} />)}</svg><span>{point}</span></li>)}</ul>
        </article>)}
      </div>
      <p class="web-caption">Representación ilustrativa: comparamos claridad y presentación, no resultados garantizados.</p>
    </section>

    <section class="web-benefits web-section" aria-labelledby="web-benefits-title"><div class="container">
      <div class="web-heading"><p class="web-eyebrow">MÁS QUE ESTAR ONLINE</p><h2 id="web-benefits-title">Una web que presenta tu negocio como se merece.</h2></div>
      <div class="web-benefits__grid">{benefits.map(benefit => <article><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{benefit.icon.map(([Tag, attributes]) => <Tag {...attributes} />)}</svg><h3>{benefit.title}</h3><p>{benefit.text}</p></article>)}</div>
    </div></section>

    <section class="web-process web-section container" aria-labelledby="web-process-title"><div class="web-heading"><p class="web-eyebrow">ASÍ TRABAJAMOS</p><h2 id="web-process-title">De tu idea a una web lista para enseñar.</h2></div><ol>{process.map((step,index) => <li><span class="web-process__number" aria-hidden="true">0{index+1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></section>
    <WebProjects />
    <WebCalculator />

    <section class="web-faq web-section container" aria-labelledby="web-faq-title">
      <div class="web-heading"><p class="web-eyebrow">ANTES DE EMPEZAR</p><h2 id="web-faq-title">Tu próxima web,<br />sin dudas pendientes.</h2><p>Lo importante, explicado sin tecnicismos.</p><a class="web-text-link" href="/seo-local/">¿También quieres mejorar tu presencia local? <span aria-hidden="true">↗</span></a></div>
      <div>{faqs.map(faq => <details><summary><span>{faq.question}</span><span class="web-faq__indicator" aria-hidden="true"></span></summary><p>{faq.answer}</p></details>)}</div>
    </section>
    <WebContact />
  </main>
  <Footer />
</BaseLayout>
