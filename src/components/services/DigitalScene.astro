---
import symbol from '../../images/branding/simbolo-7dstudio.webp';
---

<div class="digital-scene" aria-hidden="true">
  <span class="digital-scene__caption">DEL MUNDO FÍSICO AL DIGITAL</span>
  <div class="digital-scene__connection"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#8b6575" stroke-width="1.5" stroke-linecap="round" focusable="false"><path d="M8 8a6 6 0 0 1 0 8M5 5a10 10 0 0 1 0 14M11 10a3 3 0 0 1 0 4" /></svg><span>NFC</span></div>
  <div class="digital-scene__phone">
    <span class="digital-scene__speaker"></span>
    <div class="digital-scene__screen">
      <span class="digital-scene__demo">MICROLANDING · EJEMPLO</span>
      <img src={symbol.src} width={symbol.width} height={symbol.height} alt="" loading="eager" decoding="async" />
      <strong>Tu negocio,<br />a un toque.</strong>
      <span class="digital-scene__button">Ver servicios <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><path d="M5 19 19 5M5 5h14v14" /></svg></span>
      <span class="digital-scene__contact">Contactar</span>
    </div>
    <span class="digital-scene__home"></span>
  </div>
</div>

<style>
  .digital-scene { position: relative; display: grid; place-items: center; min-height: 200px; height: 100%; padding: 30px 12px 16px; background: #ede5e8; }
  .digital-scene__caption { position: absolute; top: 14px; left: 8px; right: 8px; text-align: center; color: #6e515f; font-size: 7px; font-weight: 500; letter-spacing: .06em; }
  .digital-scene__phone { position: relative; width: 104px; padding: 11px 5px 9px; border: 2px solid #554b50; border-radius: 17px; background: #fdfbfc; transform: rotate(6deg); }
  .digital-scene__speaker { position: absolute; top: 4px; left: 50%; width: 24px; height: 3px; transform: translateX(-50%); border-radius: 3px; background: #554b50; }
  .digital-scene__screen { padding: 9px 6px 10px; text-align: center; border-radius: 7px; background: #f1ecee; }
  .digital-scene__demo { display: block; color: #6e515f; font-size: 5px; line-height: 1.5; letter-spacing: .02em; }
  img { width: 24px; height: auto; margin: 8px auto; }
  strong { display: block; color: #171717; font-size: 12px; font-weight: 500; line-height: 1.2; letter-spacing: -.03em; }
  .digital-scene__button { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; padding: 7px 6px; background: #554b50; color: #fff; font-size: 6px; }
  .digital-scene__contact { display: block; margin-top: 6px; color: #6e515f; font-size: 6px; }
  .digital-scene__home { display: block; width: 26px; height: 2px; margin: 4px auto 0; border-radius: 2px; background: #554b50; }
  .digital-scene__connection { position: absolute; top: 44%; right: 5px; display: flex; flex-direction: column; align-items: center; gap: 5px; color: #6e515f; }
  .digital-scene__connection span { font-size: 8px; font-weight: 500; letter-spacing: .04em; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .digital-scene__phone { transition: transform .35s cubic-bezier(.16, 1, .3, 1); }
    .digital-scene:hover .digital-scene__phone { transform: rotate(4deg) translateY(-2px); }
  }
  @media (min-width: 960px) and (max-width: 1199px) {
    .digital-scene { padding: 32px 12px 44px; }
    .digital-scene__phone { width: 94px; }
    .digital-scene__connection { top: auto; right: auto; bottom: 10px; left: 50%; transform: translateX(-50%); flex-direction: row; gap: 3px; }
    .digital-scene__connection svg { width: 20px; height: 20px; }
  }
  @media (max-width: 959px) {
    .digital-scene { min-height: 240px; height: auto; }
    .digital-scene__phone { width: 114px; }
    .digital-scene__connection { right: calc(50% - 106px); }
  }
</style>
