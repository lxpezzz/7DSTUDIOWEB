---
import SectionCta from "../ui/SectionCta.astro";
const steps = [
  {
    title: "Nos cuentas tu idea.",
    text: "Entendemos tu negocio, tus objetivos y lo que necesitas.",
    color: "#A7752D",
    paths: [
      "M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5",
      "M9 18h6", "M10 22h4",
    ],
  },
  {
    title: "Diseñamos la solución.",
    text: "Preparamos una propuesta y desarrollamos lo acordado.",
    color: "#AB614F",
    paths: [
      "M10 3H8", "m15.007 5.008 3.987 3.986", "M20 15v4",
      "M21.174 6.813a2.82 2.82 0 0 0-3.986-3.987L3.842 16.175a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z",
      "M22 17h-4", "M4 5v4", "M6 7H2", "M9 2v2",
    ],
  },
  {
    title: "Lo ponemos en marcha.",
    text: "Publicamos, comprobamos que funciona y te explicamos cómo utilizarlo.",
    color: "#6C8067",
    paths: [
      "M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5",
      "M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09",
      "M9 12a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.4 22.4 0 0 1-4 2z",
      "M9 12H4s.55-3.03 2-4c1.62-1.08 5 .05 5 .05",
    ],
  },
];
---

<section id="como-trabajamos" class="process section container" aria-labelledby="process-title">
  <div class="process__heading">
    <h2 id="process-title" class="section-title">
      De la idea a la realidad.<br />Sin complicaciones.
    </h2>
  </div>
  <ol class="process__steps">
    {
      steps.map((step, index) => (
        <li>
          <>
            <span class="process__number" aria-hidden="true">
              0{index + 1}
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                aria-hidden="true"
              >
                <path d="M3 12h17m-6-6 6 6-6 6" />
              </svg>
            </span>
            <h3>
              <svg class="process__icon" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke={step.color} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                {step.paths.map(path => <path d={path} />)}
              </svg>
              <span>{step.title}</span>
            </h3>
            <p>{step.text}</p>
          </>
        </li>
      ))
    }
  </ol>
  <SectionCta label="Hagamos realidad tu idea" href="#contacto" variant="button" />
</section>
<style>
  .process {
    padding-top: 0px;
  }
  .process__heading {
    text-align: center;
  }
  .process__heading h2 {
    max-width: 760px;
    margin-inline: auto;
  }
  .process__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin: 64px 0 0;
    padding: 0;
    list-style: none;
  }
  li {
    border-top: 1px solid var(--color-line);
    padding-top: 20px;
  }
  .process__number {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-muted);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  li:last-child .process__number svg {
    display: none;
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 36px 0 13px;
    font-size: clamp(20px, 1.8vw, 25px);
    font-weight: 450;
    letter-spacing: -0.03em;
  }
  .process__icon {
    flex-shrink: 0;
  }
  li p {
    margin: 0;
    max-width: 290px;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.65;
  }
  @media (max-width: 767px) {
    .process__steps {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-top: 36px;
    }
    li {
      display: grid;
      grid-template-columns: 28px 1fr;
      column-gap: 16px;
    }
    .process__number {
      align-self: start;
      padding-top: 6px;
    }
    .process__number svg {
      display: none;
    }
    h3 {
      margin: 0 0 10px;
      font-size: 23px;
    }
    li p {
      grid-column: 2;
      max-width: none;
    }
  }
</style>
