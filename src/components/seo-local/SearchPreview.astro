---
import { Search, Info } from 'lucide';

const businesses = [
  {
    letter: 'A',
    name: 'Asesoría A',
    details: ['Fiscal · laboral · contable', 'Horario de atención visible · Teléfono y web disponibles'],
    label: 'Ficha completa',
  },
  {
    letter: 'B',
    name: 'Asesoría B',
    details: ['Información básica; servicios poco detallados.'],
  },
  {
    letter: 'C',
    name: 'Asesoría C',
    details: ['Ficha incompleta: faltan servicios y horarios.'],
  },
];
---

<figure class="search-preview">
  <div class="search-preview__bar">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      {Search.map(([Tag, attributes]) => <Tag {...attributes} />)}
    </svg>
    <span>asesoría en Castellón</span>
  </div>
  <div class="search-preview__map" aria-hidden="true">
    <span class="search-preview__street search-preview__street--one"></span>
    <span class="search-preview__street search-preview__street--two"></span>
    <span class="search-preview__street search-preview__street--three"></span>
    {businesses.map((business) => (
      <span class={`search-preview__pin search-preview__pin--${business.letter.toLowerCase()}`}>{business.letter}</span>
    ))}
    <span class="search-preview__area">CASTELLÓN</span>
  </div>
  <div class="search-preview__results">
    <p class="search-preview__heading">Un mismo servicio. Distinta información para elegir.</p>
    <ul class="search-preview__list" role="list">
      {businesses.map((business) => (
        <li class="search-preview__business">
          <span class="search-preview__letter" aria-hidden="true">{business.letter}</span>
          <div class="search-preview__details">
            <div class="search-preview__business-heading">
              <p class="search-preview__name">{business.name}</p>
              {business.label && <span class="search-preview__mark">{business.label}</span>}
            </div>
            {business.details.map((detail) => <p class="search-preview__detail">{detail}</p>)}
          </div>
        </li>
      ))}
    </ul>
  </div>
  <p class="search-preview__takeaway">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      {Info.map(([Tag, attributes]) => <Tag {...attributes} />)}
    </svg>
    <span>Una ficha más completa ayuda a tus clientes a conocer y valorar tu negocio.</span>
  </p>
</figure>

<style>
  .search-preview {
    min-width: 0;
    margin: 0;
    padding: 20px;
    border: 1px solid #d4d9cd;
    border-radius: 20px;
    background: #e7e9e0;
    color: var(--color-ink);
  }
  .search-preview__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid #d4d9cd;
    border-radius: 10px;
    background: #fff;
    font-size: 15px;
    line-height: 1.5;
  }
  .search-preview__bar svg {
    color: #535d49;
  }
  .search-preview__map {
    position: relative;
    height: 148px;
    overflow: hidden;
    margin-block: 14px 18px;
    border: 1px solid #cbd2c1;
    border-radius: 10px;
    background: #dce2d5;
  }
  .search-preview__street {
    position: absolute;
    display: block;
    width: 130%;
    height: 18px;
    background: #f6f7f2;
  }
  .search-preview__street--one {
    top: 42%;
    left: -10%;
    transform: rotate(-15deg);
  }
  .search-preview__street--two {
    top: 10%;
    left: -18%;
    transform: rotate(67deg);
  }
  .search-preview__street--three {
    top: 70%;
    left: 25%;
    transform: rotate(76deg);
  }
  .search-preview__pin {
    position: absolute;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 3px solid #f6f7f2;
    border-radius: 50%;
    background: #535f47;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
  }
  .search-preview__pin--a {
    top: 24%;
    left: 22%;
  }
  .search-preview__pin--b {
    top: 52%;
    left: 51%;
  }
  .search-preview__pin--c {
    top: 17%;
    left: 76%;
  }
  .search-preview__area {
    position: absolute;
    right: 14px;
    bottom: 12px;
    color: #535d49;
    font-size: 11px;
    letter-spacing: 0.1em;
  }
  .search-preview__heading {
    margin: 0 0 10px;
    color: #47563e;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .search-preview__list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .search-preview__business {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px;
    border: 1px solid #d4d9cd;
    border-radius: 8px;
    background: #fff;
  }
  .search-preview__letter {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border: 1px solid #535f47;
    border-radius: 50%;
    background: #535f47;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
  }
  .search-preview__details {
    min-width: 0;
  }
  .search-preview__business-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px 8px;
    margin-bottom: 5px;
  }
  .search-preview__name {
    margin: 2px 0 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
  }
  .search-preview__detail {
    margin: 3px 0 0;
    color: #59614f;
    font-size: 13px;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .search-preview__mark {
    display: inline-block;
    padding: 3px 7px;
    border-radius: 4px;
    background: #edf0e8;
    color: #47563e;
    font-size: 12px;
    line-height: 1.4;
  }
  .search-preview__takeaway {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin: 16px 0 0;
    color: #47563e;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .search-preview__takeaway svg {
    margin-top: 2px;
  }

  @media (max-width: 430px) {
    .search-preview {
      padding: 14px;
    }
    .search-preview__bar {
      gap: 10px;
      padding: 12px;
      font-size: 14px;
    }
    .search-preview__business {
      gap: 10px;
    }
  }
</style>
