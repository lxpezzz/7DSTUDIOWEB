---
import { services, getServiceHref } from "../../data/services";
import ServiceCard from "../services/ServiceCard.astro";
import WebScene from "../services/WebScene.astro";
import LocalScene from "../services/LocalScene.astro";
import DigitalScene from "../services/DigitalScene.astro";
import SectionCta from "../ui/SectionCta.astro";

const pageFiles = Object.keys(import.meta.glob("../../pages/**/*.{astro,md}"));
const scenes = { web: WebScene, local: LocalScene, digital: DigitalScene };
---

<div class="services-surface">
  <section
    id="servicios"
    class="services section container"
    aria-labelledby="services-title"
  >
    <div class="services__heading">
      <div class="services__title-col">
        <p class="services__label">01 / SERVICIOS</p>
        <h2 class="section-title" id="services-title">
          <span class="services__title-lead">Soluciones digitales</span>
          <span class="services__title-focus">para tu negocio.</span>
        </h2>
      </div>
      <p class="services__description">
        Diseño, visibilidad y herramientas que te ayudan a conectar con tus
        clientes.
      </p>
    </div>
    <div class="services__bento">
      {
        services.map((service) => {
          const Scene = scenes[service.scene];
          const publishedHref = getServiceHref(service, pageFiles);
          return (
            <ServiceCard
              service={service}
              href={publishedHref ?? "#contacto"}
              pending={!publishedHref}
            >
              <Scene />
            </ServiceCard>
          );
        })
      }
    </div>
    <SectionCta
      label="Cuéntanos qué necesitas"
      href="#contacto"
      variant="button"
    />
  </section>
</div>

<style>
  .services-surface {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-top: 76px;
    overflow-x: clip;
    background: #f4f1eb;
    color: #171717;
  }
  .services {
    width: min(100% - var(--gutter) * 2, 1220px);
    padding-block: 32px 36px;
  }
  .services :global(.section-cta) {
    margin-top: 32px;
  }
  .services__heading {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    align-items: end;
    gap: 20px 48px;
    margin: 0 0 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid #ddd8cf;
    text-align: left;
  }
  .services__label {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 8px;
    color: #57524d;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .services__label::before {
    content: "";
    display: block;
    width: 24px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }
  .services__heading h2 {
    margin: 0;
    font-size: clamp(30px, 3.1vw, 44px);
    font-weight: 550;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: normal;
  }
  .services__title-lead {
    display: block;
    color: #171717;
    font-weight: 580;
  }
  .services__title-focus {
    display: block;
    margin-top: 0.06em;
    color: #66615b;
    font-weight: 380;
  }
  .services__description {
    max-width: 34ch;
    margin: 0 0 4px auto;
    color: #55504b;
    font-size: 15px;
    line-height: 1.5;
  }
  .services__bento {
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(0, 1fr);
    gap: 14px;
    align-items: stretch;
  }
  @media (max-width: 1023px) {
    .services__heading {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      margin-bottom: 36px;
      padding-bottom: 24px;
    }
    .services__description {
      margin: 0;
      max-width: 48ch;
    }
    .services__bento {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 767px) {
    .services-surface {
      display: block;
      padding-top: 0;
    }
    .services {
      padding-block: 72px;
    }
    .services__heading {
      margin-bottom: 28px;
      padding-bottom: 20px;
    }
    .services__heading h2 {
      font-size: clamp(34px, 9.2vw, 48px);
    }
    .services__label {
      margin-bottom: 14px;
    }
    .services__description {
      font-size: 15px;
    }
    .services__bento {
      gap: 18px;
    }
  }
</style>
