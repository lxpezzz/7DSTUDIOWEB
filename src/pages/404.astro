---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
---

<BaseLayout
  title="Página no encontrada | 7DStudio"
  description="No encontramos esta página. Vuelve al inicio, consulta nuestros servicios o contacta con 7DStudio."
  noindex
  canonicalPath="/404.html"
>
  <Header />
  <main id="contenido" class="not-found">
    <section class="not-found__content container" aria-labelledby="not-found-title">
      <h1 id="not-found-title" class="section-title">404. <span class="heading-aside">No encontramos esta página.</span></h1>
      <p class="not-found__description body-copy">
        Puede que el enlace sea incorrecto o que la página ya no esté disponible.
        Puedes continuar desde aquí.
      </p>
      <nav class="not-found__links" aria-label="Opciones para continuar">
        <a class="button" href="/">Volver al inicio</a>
        <a class="text-link" href="/#servicios">Ver servicios</a>
        <a class="text-link" href="/contacto/">Contactar</a>
      </nav>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found {
    padding-top: var(--header-height);
  }
  .not-found__content {
    padding-block: 112px;
  }
  .not-found__content h1 {
    max-width: 19ch;
  }
  .not-found__description {
    max-width: 55ch;
    margin-block: 28px 36px;
  }
  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 32px;
  }
  @media (max-width: 767px) {
    .not-found__content {
      padding-block: 72px;
    }
  }
</style>
