---
import { site } from '../../data/site';
const configured = Boolean(site.web3formsKey);
const privacyReady = Boolean(site.privacyPolicyUrl);
---

<section id="contacto-web" class="web-contact web-section container" aria-labelledby="web-contact-title">
  <div class="web-contact__panel">
    <div class="web-contact__copy">
      <p class="web-eyebrow">HABLEMOS DE TU NEGOCIO</p>
      <h2 id="web-contact-title">¿Hablamos de tu próxima web?</h2>
      <p>Cuéntanos qué negocio tienes y qué te gustaría conseguir. Te ayudamos a darle forma.</p>
      <a class="web-text-link" data-web-quote-whatsapp href={site.whatsapp} target="_blank" rel="noopener noreferrer">¿Prefieres WhatsApp? Hablemos directamente <span aria-hidden="true">↗</span><span class="sr-only"> (se abre en una pestaña nueva)</span></a>
    </div>
    <form id="web-contact-form" class="web-contact__form" aria-labelledby="web-form-title" action={configured ? 'https://api.web3forms.com/submit' : site.whatsapp} method={configured ? 'POST' : 'GET'} data-configured={String(configured)} data-privacy-ready={String(privacyReady)}>
      <h3 id="web-form-title">Cuéntanos un poco más</h3>
      {(!configured || !privacyReady) && <p class="web-contact__availability">El formulario aún no admite envíos. Puedes consultar tu proyecto por WhatsApp, sin rellenar estos campos.</p>}
      <div class="web-contact__budget" data-budget-selection hidden>
        <p data-budget-preview></p>
        <details class="web-contact__breakdown"><summary>Ver configuración y condiciones</summary><p data-budget-details></p></details>
        <button type="button" data-clear-budget>Quitar selección</button>
      </div>
      {configured && <>
        <input type="hidden" name="access_key" value={site.web3formsKey} />
        <input type="hidden" name="subject" value="Consulta Diseño Web · 7D Studio" />
        <input type="hidden" name="from_name" value="7D Studio" />
      </>}
      <input type="hidden" name="source" value="Página Diseño Web · /diseno-web/" />
      <input type="hidden" name="service" value="Diseño web" />
      <input type="hidden" name="budget_summary" value="" />
      <div class="web-contact__trap" aria-hidden="true"><label for="web-website">Deja este campo vacío</label><input id="web-website" name="botcheck" tabindex="-1" autocomplete="off" /></div>
      <div class="web-contact__fields">
        <div><label for="web-name">Nombre <span class="sr-only">(obligatorio)</span></label><input id="web-name" name="name" autocomplete="name" required maxlength="100" /></div>
        <div><label for="web-email">Correo electrónico <span class="sr-only">(obligatorio)</span></label><input id="web-email" type="email" name="email" autocomplete="email" required maxlength="254" /></div>
        <div class="web-contact__wide"><label for="web-business">Nombre del negocio <span>(opcional)</span></label><input id="web-business" name="business" autocomplete="organization" maxlength="150" /></div>
        <div class="web-contact__wide"><label for="web-message">Mensaje <span class="sr-only">(obligatorio)</span></label><textarea id="web-message" name="message" required minlength="10" maxlength="4000" rows="3"></textarea></div>
      </div>
      <label class="web-contact__privacy"><input type="checkbox" name="privacy" value="accepted" required disabled={!privacyReady} aria-describedby={!privacyReady ? 'web-contact-notice' : undefined} /><span>He leído y acepto {privacyReady ? <a href={site.privacyPolicyUrl} target="_blank" rel="noopener noreferrer">la política de privacidad<span class="sr-only"> (se abre en una pestaña nueva)</span></a> : 'la política de privacidad'}.</span></label>
      <p class="web-contact__notice" id="web-contact-notice">{!privacyReady ? 'El formulario estará disponible cuando publiquemos la política de privacidad. Mientras tanto, puedes escribirnos por WhatsApp.' : configured ? 'Usaremos tus datos para responder a tu consulta. El envío se procesa a través de Web3Forms.' : 'El envío por email aún no está disponible. Prepararemos tu mensaje para que lo revises y lo envíes por WhatsApp. No se envía automáticamente.'}</p>
      <button class="contact__submit" type="submit" disabled={!configured || !privacyReady} aria-describedby="web-contact-notice">Enviar consulta <span aria-hidden="true">↗</span></button>
      <p class="contact__feedback" role="status" aria-live="polite" tabindex="-1"></p>
      <a class="contact__continue" href={site.whatsapp} hidden>Abrir mi mensaje en WhatsApp ↗</a>
      <noscript><p class="web-contact__notice">{configured && privacyReady ? 'Puedes enviar este formulario sin JavaScript.' : 'Utiliza el enlace directo a WhatsApp para contarnos tu proyecto.'}</p></noscript>
    </form>
  </div>
</section>

<style>
  .web-contact__panel { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: center; gap: 40px; padding: 36px; border: 1px solid #d8c7ba; border-radius: 18px; background: var(--web-beige); }
  .web-contact__copy { min-width: 0; }
  .web-contact__copy h2 { max-width: 17ch; }
  .web-contact__copy > p:not(.web-eyebrow) { max-width: 40ch; margin: 24px 0; color: var(--web-muted); font-size: 16px; line-height: 1.7; }
  .web-contact__form { min-width: 0; padding: 24px; border: 1px solid var(--web-border); border-radius: 14px; background: #fff; }
  .web-contact__form h3 { margin: 0 0 20px; font-size: 24px; font-weight: 500; letter-spacing: -0.025em; }
  .web-contact__budget { margin-bottom: 20px; padding: 12px; border-left: 3px solid #b88470; background: var(--web-surface); }
  .web-contact__budget p { margin: 0; font-size: 13px; line-height: 1.6; }
  .web-contact__availability { margin: 0 0 20px; color: var(--web-muted); font-size: 13px; line-height: 1.6; }
  .web-contact__breakdown summary { display: flex; align-items: center; min-height: 44px; color: var(--web-accent-text); font-size: 13px; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .web-contact__breakdown [data-budget-details] { white-space: pre-line; overflow-wrap: anywhere; }
  .web-contact__budget button { min-height: 44px; padding: 0; border: 0; background: none; color: var(--web-accent); font: inherit; font-size: 12px; text-decoration: underline; text-underline-offset: 3px; }
  .web-contact__fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .web-contact__fields > div { min-width: 0; }
  .web-contact__wide { grid-column: 1 / -1; }
  .web-contact__fields label { display: block; margin-bottom: 7px; font-size: 13px; font-weight: 500; line-height: 1.5; }
  .web-contact__fields label > span:not(.sr-only) { color: var(--web-muted); font-weight: 400; }
  .web-contact__fields input, .web-contact__fields textarea { display: block; width: 100%; min-height: 44px; padding: 10px 12px; border: 1px solid var(--web-border); border-radius: 7px; background: #fff; color: var(--web-ink); font: inherit; font-size: 16px; line-height: 1.5; }
  .web-contact__fields textarea { min-height: 104px; resize: vertical; }
  .web-contact__privacy { display: flex; align-items: start; gap: 10px; min-height: 44px; margin-top: 16px; padding-block: 6px; color: var(--web-muted); font-size: 12px; line-height: 1.6; }
  .web-contact__privacy input { flex-shrink: 0; width: 18px; height: 18px; margin: 1px 0 0; accent-color: var(--web-accent); }
  .web-contact__privacy a { text-decoration: underline; text-underline-offset: 3px; }
  .web-contact__notice { margin: 6px 0 16px; color: var(--web-muted); font-size: 12px; line-height: 1.6; }
  .contact__submit { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; min-height: 50px; padding: 13px 16px; border: 1px solid var(--web-ink); border-radius: 7px; background: var(--web-ink); color: #fff; font: inherit; font-size: 14px; font-weight: 500; }
  .contact__submit:disabled { cursor: not-allowed; opacity: 0.6; }
  .contact__submit:hover:not(:disabled) { background: #39312c; }
  .contact__feedback { margin: 12px 0 0; font-size: 13px; line-height: 1.6; }
  .contact__feedback:empty { display: none; }
  .contact__continue { display: inline-flex; align-items: center; min-height: 44px; margin-top: 8px; color: var(--web-accent); font-size: 13px; text-decoration: underline; }
  .web-contact__trap { display: none; }
  @media (max-width: 959px) { .web-contact__panel { grid-template-columns: minmax(0, 1fr); gap: 28px; padding: 24px; } }
  @media (max-width: 599px) { .web-contact__panel { padding: 24px 12px; } .web-contact__form { padding: 18px 14px; } .web-contact__fields { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  import { initContactForm } from '../../scripts/contact-form';
  const form = document.querySelector<HTMLFormElement>('#web-contact-form');
  if (form && !form.dataset.initialized) {
    form.dataset.initialized = 'true';
    initContactForm(form);
    const input = form.querySelector<HTMLInputElement>('[name="budget_summary"]')!;
    const selection = form.querySelector<HTMLElement>('[data-budget-selection]')!;
    const clear = () => { input.value = ''; selection.hidden = true; };
    form.querySelector('[data-clear-budget]')?.addEventListener('click', clear);
    form.addEventListener('reset', () => queueMicrotask(clear));
  }
</script>
