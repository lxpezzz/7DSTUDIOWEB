---
import { getHomeProjects } from '../../data/projects';
import ProjectCatalogue from '../ui/ProjectCatalogue.astro';

const featured = getHomeProjects();
// El CTA solo se activa cuando exista una página Astro real, sin crear rutas vacías.
const hasProjectsPage = Object.keys(import.meta.glob('../../pages/proyectos{,/index}.astro')).length > 0;
---

<section id="proyectos" class="projects section" aria-labelledby="projects-title">
  <div class="container">
    <div class="projects__heading">
      <p class="section-label"><span>02 /</span>PROYECTOS</p>
      <div>
        <h2 class="section-title" id="projects-title">Diseñamos webs que hablan por sí solas.</h2>
        <p class="body-copy">Explora algunas de nuestras propuestas y descubre cómo podemos dar forma a la presencia digital de tu negocio.</p>
      </div>
    </div>

    <ProjectCatalogue items={featured} />

    {featured.length === 0 && <div class="projects__empty">
      <p class="projects__status">DEMOSTRACIONES EN PREPARACIÓN</p>
      <div>
        <p class="projects__empty-copy">Añadiremos aquí las capturas y los enlaces de las demostraciones cuando estén disponibles.</p>
        <a class="text-link" href="#contacto">Mientras tanto, hablemos de tu proyecto<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
      </div>
    </div>}

    <div class="projects__footer">
      {hasProjectsPage ? <a class="text-link" href="/proyectos/">Ver todos los proyectos<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
        : <p class="projects__pending">Ver todos los proyectos<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg><span>Próximamente</span></p>}
    </div>
  </div>
</section>

<style>
  .projects { background: var(--color-paper); }
  .projects__heading { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; }
  .section-label { margin: 7px 0 0; }
  .section-title { max-width: 720px; }
  .body-copy { max-width: 510px; margin: 26px 0 0; }
  .projects__empty { margin-top: 64px; border-top: 1px solid var(--color-line); padding-block: 30px 40px; display: grid; grid-template-columns: 1fr 2fr; gap: 48px; }
  .projects__status { margin: 7px 0 0; color: var(--color-muted); font-size: 10px; line-height: 1.6; letter-spacing: .06em; }
  .projects__empty-copy { max-width: 575px; margin: 0 0 24px; font-size: clamp(20px, 2vw, 27px); line-height: 1.45; letter-spacing: -.02em; }
  .projects__footer { display: flex; justify-content: flex-end; border-top: 1px solid var(--color-line); padding-top: 24px; }
  .projects__pending { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 0; color: var(--color-muted); font-size: 14px; line-height: 1.6; }
  .projects__pending span { font-size: 11px; margin-left: 12px; }
  @media (max-width: 767px) {
    .projects__heading { grid-template-columns: 1fr; gap: 26px; }
    .body-copy { margin-top: 22px; }
    .projects__empty { margin-top: 36px; grid-template-columns: 1fr; gap: 24px; padding-block: 24px 32px; }
    .projects__empty .text-link { font-size: 13px; }
    .projects__footer { justify-content: flex-start; }
    .projects__pending span { width: 100%; margin-left: 0; }
  }
</style>
