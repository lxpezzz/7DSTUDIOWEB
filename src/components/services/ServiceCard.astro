---
import type { Service } from "../../data/services";
interface Props {
  service: Service;
  href?: string;
  pending?: boolean;
}
const { service, href, pending = !href } = Astro.props;
const Card = href ? "a" : "article";
const titleId = `service-${service.id}-${crypto.randomUUID()}`;
const serviceLabel = { web: "diseño web", local: "SEO local", digital: "soluciones" }[service.scene];
const ctaLabel = `${pending ? "Consultar" : "Ver"} ${serviceLabel}`;
---

<Card
  id={service.id === 'productos-fisicos' ? 'productos' : undefined}
  class:list={[
    "service-card",
    `service-card--${service.scene}`,
    { "service-card--linked": !!href, "service-card--pending": pending },
  ]}
  href={href}
  draggable={href ? "false" : undefined}
  aria-labelledby={href ? undefined : titleId}
  data-service={service.id}
>
  <div class="service-card__scene"><slot /></div>
  <div class="service-card__copy">
    <div class="service-card__body">
      <div class="service-card__heading">
        <h3 id={titleId}>{service.title}</h3>
        <svg
          class="service-card__arrow"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
        >
      </div>
      <p class="service-card__description">{service.description}</p>
    </div>
    <div class="service-card__footer">
      <ul
        class="service-card__tags"
        aria-label={`Especialidades de ${service.title}`}
      >
        {service.tags.map((tag) => <li>{tag}</li>)}
      </ul>
      {href && (
        <span class="service-card__cta">
          {ctaLabel}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg>
        </span>
      )}
    </div>
  </div>
</Card>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0;
    border: 1px solid #dfd9cf;
    border-radius: 16px;
    background: #fff;
    color: #171717;
    overflow: hidden;
    box-shadow: 0 2px 12px 0 transparent, 0 4px 24px -4px transparent;
  }
  .service-card--web {
    --card-accent: #e9dfd1;
    --card-accent-ink: #82705c;
    grid-row: span 2;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
  }
  .service-card--local { --card-accent: #dfe4d7; --card-accent-ink: #59674f; }
  .service-card--digital { --card-accent: #e9dee5; --card-accent-ink: #7e6072; }
  .service-card--local,
  .service-card--digital {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    min-height: 204px;
  }
  .service-card__scene {
    min-width: 0;
    overflow: hidden;
    isolation: isolate;
  }
  .service-card--web .service-card__scene {
    border-bottom: 1px solid #ebe6de;
  }
  .service-card--local .service-card__scene,
  .service-card--digital .service-card__scene {
    border-right: 1px solid #ebe6de;
  }
  .service-card__copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
    min-width: 0;
    padding: 18px 22px 18px;
    user-select: text;
  }
  .service-card--web .service-card__copy {
    padding: 18px 24px 20px;
    gap: 12px;
  }
  .service-card--web .service-card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 20px;
    padding-top: 12px;
    border-top: 1px solid #eeeae3;
  }
  .service-card--web .service-card__tags {
    margin: 0;
  }
  .service-card--web .service-card__cta {
    margin: 0;
  }
  .service-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .service-card__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  h3 {
    margin: 0;
    font-size: clamp(26px, 2vw, 33px);
    line-height: 1.06;
    font-weight: 520;
    letter-spacing: -0.038em;
  }
  .service-card--local h3,
  .service-card--digital h3 {
    font-size: clamp(20px, 1.55vw, 24px);
  }
  .service-card__arrow {
    flex-shrink: 0;
    margin-top: 3px;
    opacity: 0.45;
  }
  .service-card__description {
    max-width: 44ch;
    margin: auto 0;
    padding-block: 10px 6px;
    color: #55504b;
    font-size: 15px;
    line-height: 1.5;
  }
  .service-card--local .service-card__description,
  .service-card--digital .service-card__description {
    max-width: 30ch;
    padding-block: 12px 8px;
    font-size: 14.5px;
    line-height: 1.48;
  }
  .service-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin: 0;
    padding: 0;
    list-style: none;
    color: #5c5752;
    font-size: 12.5px;
    line-height: 1.45;
  }
  .service-card__tags li:not(:last-child)::after {
    content: "·";
    margin-inline: 8px;
  }
  .service-card--linked {
    cursor: pointer;
  }
  .service-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    margin-top: 10px;
    padding: 8px 14px;
    border: 1px solid #171717;
    border-radius: 3px;
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.3;
    user-select: none;
  }
  .service-card__cta svg { flex-shrink: 0; }
  .service-card--linked:focus-visible .service-card__cta {
    background: #171717;
    color: #fff;
  }
  @media (hover: hover) {
    .service-card--linked:hover .service-card__cta {
      background: #171717;
      color: #fff;
    }
  }
  .service-card--linked:not(.service-card--pending) .service-card__arrow {
    opacity: 1;
  }
  .service-card--linked:focus-visible {
    outline: 2px solid #171717;
    outline-offset: 4px;
    border-color: color-mix(in srgb, var(--card-accent) 65%, var(--card-accent-ink));
    box-shadow: 0 2px 12px 0 color-mix(in srgb, var(--card-accent) 34%, transparent),
      0 4px 24px -4px color-mix(in srgb, var(--card-accent) 30%, transparent);
  }
  .service-card--linked:focus-visible .service-card__arrow {
    color: var(--card-accent-ink);
    opacity: 1;
    transform: translate(4px, -4px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .service-card__cta { transition: background-color 220ms ease, color 220ms ease; }
    .service-card__cta svg { transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1); }
    .service-card { transition: border-color 250ms ease-out, box-shadow 250ms ease-out; }
    .service-card__arrow { transition: color 250ms ease-out, opacity 250ms ease-out, transform 350ms cubic-bezier(0.16, 1, 0.3, 1); }
  }
  @media (hover: hover) and (pointer: fine) {
    .service-card--linked:hover {
      border-color: color-mix(in srgb, var(--card-accent) 65%, var(--card-accent-ink));
      box-shadow: 0 2px 12px 0 color-mix(in srgb, var(--card-accent) 34%, transparent),
        0 4px 24px -4px color-mix(in srgb, var(--card-accent) 30%, transparent);
    }
    .service-card--linked:hover .service-card__arrow {
      color: var(--card-accent-ink);
      opacity: 1;
      transform: translate(4px, -4px);
    }
    .service-card--linked:hover .service-card__cta svg {
      transform: translate(3px, -3px);
    }
  }
  @media (max-width: 1023px) {
    .service-card,
    .service-card--web {
      display: flex;
      flex-direction: column;
      grid-row: auto;
      min-height: 0;
    }
    .service-card--local,
    .service-card--digital {
      min-height: 260px;
    }
    .service-card__scene {
      width: 100%;
    }
    .service-card__description {
      max-width: 52ch;
    }
  }
  @media (max-width: 767px) {
    .service-card--local,
    .service-card--digital {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    .service-card--local .service-card__scene,
    .service-card--digital .service-card__scene {
      border-right: 0;
      border-bottom: 1px solid #ebe6de;
    }
    .service-card__copy,
    .service-card--web .service-card__copy {
      padding: 22px 20px 24px;
      gap: 18px;
    }
    .service-card--web .service-card__footer {
      flex-direction: column;
      align-items: flex-start;
      padding-top: 14px;
    }
    h3,
    .service-card--local h3,
    .service-card--digital h3 {
      font-size: 27px;
    }
  }
</style>
