---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SectionCta from '../components/ui/SectionCta.astro';
import SearchPreview from '../components/seo-local/SearchPreview.astro';
import ProfileComparison from '../components/seo-local/ProfileComparison.astro';
import SeoPlans from '../components/seo-local/SeoPlans.astro';
import { site } from '../data/site';

const title = 'SEO local en Castellón para pequeños negocios | 7D Studio';
const description = 'Ayudamos a pequeños negocios a mejorar su presencia en Google. Descubre cómo trabajamos el SEO local y consulta nuestros planes Estándar y Premium.';
const contactUrl = new URL(site.whatsapp);
contactUrl.searchParams.set('text', 'Hola, me gustaría mejorar la visibilidad local de mi negocio. ¿Podemos hablar?');
const contactHref = contactUrl.href;
const work = [
  { label: 'Tu punto de partida', title: 'Analizamos tu presencia', text: 'Revisamos cómo aparece tu negocio en Google y detectamos posibles mejoras.' },
  { label: 'Información que ayuda', title: 'Mejoramos tu información', text: 'Trabajamos la presentación de tu negocio para que tus clientes encuentren información clara y útil.' },
  { label: 'Confianza, no solo visibilidad', title: 'Cuidamos tu reputación digital', text: 'Te ayudamos a gestionar aspectos de tu presencia online que influyen en la confianza de tus clientes.' },
  { label: 'Una visión de lo que cambia', title: 'Revisamos la evolución', text: 'Analizamos los indicadores disponibles para conocer cómo evoluciona tu presencia local.' },
];
const steps = [
  { title: 'Nos cuentas tu negocio', text: 'Nos explicas qué haces, dónde trabajas y qué necesitas mejorar.' },
  { title: 'Revisamos tu situación', text: 'Analizamos tu presencia actual y las oportunidades de mejora.' },
  { title: 'Te proponemos cómo avanzar', text: 'Te explicamos qué plan encaja mejor con tu situación.' },
];
const faqs = [
  {
    question: '¿Qué es exactamente el SEO local?',
    answer: 'Es el trabajo de mejorar la presencia de un negocio cuando alguien busca un servicio en su zona. Por ejemplo, una asesoría en Castellón. Incluye cuidar la información que permite entender qué haces, dónde estás y cómo contactar contigo.',
  },
  {
    question: '¿Necesito una página web para trabajar mi SEO local?',
    answer: 'No siempre. Podemos empezar por revisar tu Perfil de Empresa de Google y tu presencia actual. Una web puede complementar esa información y explicar mejor tus servicios. Valoramos qué tiene sentido para tu negocio antes de proponerte nada.',
  },
  {
    question: '¿Cuánto tiempo se tarda en ver resultados?',
    answer: 'Depende de tu punto de partida, de la competencia y de las búsquedas de tu zona. Hay mejoras de información que se ven al actualizar la ficha; los cambios de visibilidad pueden ser graduales. No garantizamos plazos concretos ni posiciones.',
  },
  {
    question: '¿Qué diferencia hay entre SEO local y Google Ads?',
    answer: 'Google Ads muestra anuncios con un presupuesto publicitario. El SEO local trabaja tu presencia en los resultados que no son anuncios. Son enfoques distintos que pueden complementarse; pagar anuncios no sustituye tener una información clara y actualizada.',
  },
  {
    question: '¿Mi negocio puede mejorar si ya aparece en Google?',
    answer: 'Sí. Aparecer es solo una parte. Conviene revisar si los horarios son correctos, si se entienden tus servicios y si la ficha responde a las dudas de tus clientes. Una presentación más útil puede ayudarles a decidir, sin que eso garantice una posición mejor.',
  },
  {
    question: '¿Tengo que pagar a Google para tener una ficha de empresa?',
    answer: 'No. El Perfil de Empresa de Google es gratuito. El servicio de 7D Studio corresponde al trabajo profesional de optimización y seguimiento. No es una tasa de Google ni un pago por ocupar un puesto en sus resultados.',
  },
];
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: `${site.url}/seo-local/`,
    about: { '@type': 'Service', name: 'SEO local', provider: { '@type': 'Organization', name: site.name, url: site.url } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'SEO local', item: `${site.url}/seo-local/` },
    ],
  },
];
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <Header />
  <main id="contenido" class="seo-page">
    <section class="seo-hero container" aria-labelledby="seo-title">
      <nav class="seo-hero__breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">SEO local</span>
      </nav>
      <div class="seo-hero__layout">
        <div class="seo-hero__copy">
          <p class="seo-page__label">SEO LOCAL / 7D STUDIO</p>
          <h1 id="seo-title">Tus próximos clientes te están buscando en Google. ¿Te encuentran a ti?</h1>
          <p class="seo-hero__description">Trabajamos tu presencia local para ayudarte a aparecer en búsquedas relevantes y transmitir confianza.</p>
          <a class="button" href={contactHref} target="_blank" rel="noopener noreferrer">Quiero mejorar mi visibilidad <span aria-hidden="true">↗</span><span class="sr-only"> por WhatsApp (se abre en una pestaña nueva)</span></a>
          <a class="seo-hero__secondary" href="#como-funciona">Primero, te contamos cómo funciona <span aria-hidden="true">↓</span></a>
        </div>
        <SearchPreview />
      </div>
    </section>

    <section id="como-funciona" class="journey container" aria-labelledby="journey-title">
      <div class="seo-page__heading">
        <h2 id="journey-title">El cliente necesita algo.<br />La pregunta es a quién encuentra.</h2>
        <p>No necesita saber qué es el SEO. Necesita encontrar un negocio que pueda ayudarle.</p>
      </div>
      <ol class="journey__steps">
        <li>
          <span class="journey__number" aria-hidden="true">01</span>
          <h3>Busca</h3>
          <p>Una persona necesita un servicio y lo busca en Google.</p>
          <div class="journey__example">“asesoría cerca de mí”</div>
        </li>
        <li>
          <span class="journey__number" aria-hidden="true">02</span>
          <h3>Compara</h3>
          <p>Encuentra distintos negocios. Consulta sus horarios, servicios, fotografías y reseñas.</p>
          <div class="journey__example journey__example--compare" aria-label="Ejemplos de negocios que compara"><span>Negocio A</span><span>Negocio B</span><span>Negocio C</span></div>
        </li>
        <li>
          <span class="journey__number" aria-hidden="true">03</span>
          <h3>Contacta</h3>
          <p>Escoge un negocio que le parece adecuado y fiable.</p>
          <div class="journey__example">Encuentra cómo llamar o escribir</div>
        </li>
      </ol>
      <p class="journey__takeaway">Si tu negocio no aparece en esas búsquedas, o tu ficha no transmite confianza, puedes quedar fuera de la elección.</p>
    </section>

    <ProfileComparison />

    <section class="work" aria-labelledby="work-title">
      <div class="container work__layout">
        <div class="work__intro">
          <p class="seo-page__label">CÓMO TE AYUDAMOS</p>
          <h2 id="work-title">Que te encuentren.<br />Y entiendan por qué elegirte.</h2>
          <p>Nos ocupamos de traducir tu negocio a una presencia local clara, útil y cuidada.</p>
        </div>
        <div class="work__modules">
          {work.map(item => <article class="work__module">
            <p class="work__label">{item.label}</p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>)}
        </div>
        <p class="work__scope">Estos bloques explican nuestra forma de trabajar. No son una lista de prestaciones incluidas en ambos planes: el alcance concreto se define contigo.</p>
      </div>
    </section>

    <SeoPlans />

    <section class="starting container" aria-labelledby="starting-title">
      <div class="seo-page__heading">
        <p class="seo-page__label">CÓMO EMPEZAMOS</p>
        <h2 id="starting-title">Empezamos por conocerte.</h2>
      </div>
      <ol class="starting__steps">
        {steps.map((step, index) => <li>
          <span class="starting__number" aria-hidden="true">0{index + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>)}
      </ol>
    </section>

    <section class="faq container" aria-labelledby="faq-title">
      <div class="faq__intro">
        <p class="seo-page__label">SIN TECNICISMOS</p>
        <h2 id="faq-title">Es normal tener preguntas.</h2>
        <p>Estas son algunas de las primeras que suelen surgir al hablar de visibilidad local.</p>
      </div>
      <div class="faq__list">
        {faqs.map(faq => <details>
          <summary>{faq.question}<span class="faq__indicator" aria-hidden="true"></span></summary>
          <p>{faq.answer}</p>
        </details>)}
      </div>
    </section>

    <section class="seo-contact container" aria-labelledby="seo-contact-title">
      <div class="seo-contact__panel">
        <h2 id="seo-contact-title">¿Sabes cómo aparece tu negocio en Google?</h2>
        <p>Cuéntanos qué negocio tienes y vemos cómo podemos ayudarte a mejorar tu presencia local.</p>
        <SectionCta label="Hablemos de tu negocio" href={contactHref} variant="button" external />
      </div>
      <p class="seo-contact__related">¿También necesitas una web o productos QR/NFC? <a href="/#servicios">Conoce los otros servicios de 7D Studio ↗</a></p>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .seo-page {
    color: var(--color-ink);
  }
  .seo-page a:focus-visible,
  .seo-page summary:focus-visible {
    outline: 2px solid #47563e;
    outline-offset: 5px;
  }
  .seo-page ::selection {
    background: #dce2d5;
    color: #171717;
  }
  .seo-page__label {
    margin: 0 0 20px;
    color: #59674f;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .08em;
    line-height: 1.6;
  }
  .seo-hero {
    padding-top: calc(var(--header-height) + 36px);
    padding-bottom: 80px;
  }
  .seo-hero__breadcrumb {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 36px;
    color: var(--color-muted);
    font-size: 12px;
  }
  .seo-hero__breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .seo-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .seo-hero__copy {
    min-width: 0;
  }
  h1 {
    max-width: 19ch;
    margin: 0;
    font-size: clamp(40px, 4vw, 60px);
    font-weight: 450;
    line-height: 1.07;
    letter-spacing: -.04em;
    text-wrap: balance;
  }
  .seo-hero__description {
    max-width: 43ch;
    margin: 28px 0 32px;
    color: var(--color-muted);
    font-size: 17px;
    line-height: 1.7;
  }
  .seo-hero__copy > .button {
    max-width: 100%;
  }
  .seo-hero__secondary {
    display: flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    min-height: 44px;
    margin-top: 12px;
    color: #59674f;
    font-size: 13px;
    line-height: 1.6;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  h2 {
    margin: 0;
    font-size: clamp(30px, 3.3vw, 46px);
    font-weight: 450;
    line-height: 1.13;
    letter-spacing: -.04em;
    text-wrap: balance;
  }
  .seo-page__heading {
    max-width: 790px;
    margin-bottom: 40px;
  }
  .seo-page__heading > p:not(.seo-page__label) {
    margin: 24px 0 0;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.7;
  }
  .journey {
    padding-block: 64px 80px;
    border-top: 1px solid var(--color-line);
  }
  .journey__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border: 1px solid #d4d9cd;
    border-radius: 18px;
    background: #e7e9e0;
    list-style: none;
  }
  .journey__steps > li {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 28px;
  }
  .journey__steps > li + li {
    border-left: 1px solid #cbd2c1;
  }
  .journey__number,
  .starting__number {
    color: #59674f;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .journey h3,
  .starting h3 {
    margin: 22px 0 12px;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -.025em;
    line-height: 1.2;
  }
  .journey__steps p {
    margin: 0 0 24px;
    color: #535d49;
    font-size: 15px;
    line-height: 1.7;
  }
  .journey__example {
    margin-top: auto;
    padding: 14px;
    border: 1px solid #d4d9cd;
    border-radius: 8px;
    background: #fff;
    font-size: 13px;
    line-height: 1.6;
  }
  .journey__example--compare {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 11px;
  }
  .journey__example--compare > span {
    padding: 2px 5px;
    background: #f2f4ee;
    color: #535d49;
  }
  .journey__takeaway {
    max-width: 75ch;
    margin: 28px 0 0;
    color: var(--color-muted);
    font-size: 17px;
    line-height: 1.7;
  }
  .work {
    padding-block: 80px;
    background: #eeefe9;
  }
  .work__layout {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    gap: 40px 64px;
  }
  .work__intro > p:last-child {
    max-width: 35ch;
    margin: 28px 0 0;
    color: #59674f;
    font-size: 16px;
    line-height: 1.7;
  }
  .work__modules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 28px;
  }
  .work__module {
    border-top: 1px solid #cbd2c1;
    padding-top: 20px;
  }
  .work__label {
    margin: 0 0 18px;
    color: #59674f;
    font-size: 11px;
    line-height: 1.6;
  }
  .work h3 {
    margin: 0 0 16px;
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -.025em;
    line-height: 1.25;
  }
  .work__module > p:last-child {
    margin: 0;
    color: #59674f;
    font-size: 14px;
    line-height: 1.7;
  }
  .work__scope {
    grid-column: 1 / -1;
    max-width: 100ch;
    margin: 0;
    color: #59674f;
    font-size: 12px;
    line-height: 1.7;
  }
  .starting {
    padding-block: 64px 80px;
    border-top: 1px solid var(--color-line);
  }
  .starting__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .starting__steps > li {
    padding-top: 24px;
    border-top: 1px solid #cbd2c1;
  }
  .starting__steps p {
    max-width: 37ch;
    margin: 0;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.7;
  }
  .faq {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: 64px;
    padding-block: 80px;
    border-top: 1px solid var(--color-line);
  }
  .faq__intro > p:last-child {
    max-width: 35ch;
    margin: 24px 0 0;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.7;
  }
  .faq details {
    border-bottom: 1px solid var(--color-line);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 64px;
    padding-block: 20px;
    font-size: 16px;
    line-height: 1.5;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq__indicator {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }
  .faq__indicator::before,
  .faq__indicator::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 0;
    width: 14px;
    height: 1px;
    background: #59674f;
  }
  .faq__indicator::after {
    transform: rotate(90deg);
  }
  .faq details[open] .faq__indicator::after {
    display: none;
  }
  .faq details > p {
    margin: 0 0 24px;
    padding-right: 32px;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.8;
  }
  .faq summary:hover {
    color: #47563e;
  }
  .seo-contact {
    padding-block: 40px 64px;
  }
  .seo-contact__panel {
    padding: 48px;
    border: 1px solid #cbd2c1;
    border-radius: 18px;
    background: #e7e9e0;
    text-align: center;
  }
  .seo-contact h2 {
    max-width: 22ch;
    margin-inline: auto;
    font-size: clamp(30px, 3vw, 42px);
  }
  .seo-contact__panel > p {
    max-width: 58ch;
    margin: 22px auto 0;
    color: #535d49;
    font-size: 16px;
    line-height: 1.7;
  }
  .seo-contact__related {
    margin: 28px 0 0;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.8;
    text-align: center;
  }
  .seo-contact__related a {
    display: inline-block;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 1023px) {
    .seo-hero__layout {
      gap: 28px;
    }
    .work__layout,
    .faq {
      grid-template-columns: minmax(0, 1fr);
    }
    .work__intro {
      max-width: 680px;
    }
    .work__intro > p:last-child {
      max-width: 60ch;
    }
    .journey__steps > li {
      padding: 22px;
    }
    .starting__steps {
      gap: 28px;
    }
  }
  @media (max-width: 767px) {
    .seo-hero {
      padding-top: calc(var(--header-height) + 24px);
      padding-bottom: 64px;
    }
    .seo-hero__breadcrumb {
      margin-bottom: 28px;
    }
    .seo-hero__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    h1 {
      font-size: clamp(40px, 8vw, 54px);
    }
    .seo-hero__description {
      font-size: 16px;
    }
    .journey,
    .starting,
    .faq,
    .work {
      padding-block: 64px;
    }
    .journey__steps,
    .starting__steps,
    .work__modules {
      grid-template-columns: minmax(0, 1fr);
    }
    .journey__steps > li {
      padding: 24px;
    }
    .journey__steps > li + li {
      border-left: 0;
      border-top: 1px solid #cbd2c1;
    }
    .journey__takeaway {
      font-size: 16px;
    }
    .faq {
      gap: 28px;
    }
    .seo-contact__panel {
      padding: 32px 24px;
    }
    .seo-contact__related a {
      padding-block: 8px;
    }
  }
</style>
