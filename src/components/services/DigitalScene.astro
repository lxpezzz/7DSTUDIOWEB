---
import { brand } from '../../data/brand';
---

<div class="digital-scene" aria-hidden="true">
  <span class="digital-scene__caption">DEL MUNDO FÍSICO AL DIGITAL</span>
  <div class="digital-scene__connection"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#8b6575" stroke-width="1.5" stroke-linecap="round" focusable="false"><path d="M8 8a6 6 0 0 1 0 8M5 5a10 10 0 0 1 0 14M11 10a3 3 0 0 1 0 4" /></svg><span>NFC</span></div>
  <div class="digital-scene__phone">
    <span class="digital-scene__speaker"></span>
    <div class="digital-scene__screen">
      <span class="digital-scene__demo">MICROLANDING · EJEMPLO</span>
      <img src={brand.symbol} width="512" height="512" alt="" loading="lazy" decoding="async" />
      <strong>Tu negocio,<br />a un toque.</strong>
      <span class="digital-scene__button">Ver servicios <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><path d="M5 19 19 5M5 5h14v14" /></svg></span>
      <span class="digital-scene__contact">Contactar</span>
    </div>
    <span class="digital-scene__home"></span>
  </div>
</div>

<style>
  .digital-scene { position: relative; display: grid; place-items: center; min-height: 196px; height: 100%; padding: 24px 12px 14px; background: #ede5e8; }
  .digital-scene__caption { position: absolute; top: 10px; left: 10px; right: 10px; text-align: center; color: #6e515f; font-size: 8px; font-weight: 500; letter-spacing: .08em; }
  .digital-scene__phone { position: relative; width: 104px; padding: 9px 5px 7px; border: 2px solid #554b50; border-radius: 16px; background: #fdfbfc; transform: rotate(5deg); }
  .digital-scene__speaker { position: absolute; top: 5px; left: 50%; width: 28px; height: 3px; transform: translateX(-50%); border-radius: 3px; background: #554b50; }
  .digital-scene__screen { padding: 10px 7px 11px; text-align: center; border-radius: 8px; background: #f1ecee; }
  .digital-scene__demo { display: block; color: #6e515f; font-size: 6px; line-height: 1.5; letter-spacing: .02em; }
  img { width: 28px; height: auto; margin: 9px auto; }
  strong { display: block; color: #171717; font-size: 13.5px; font-weight: 550; line-height: 1.2; letter-spacing: -.03em; }
  .digital-scene__button { display: flex; justify-content: space-between; align-items: center; margin-top: 13px; padding: 8px 7px; background: #554b50; color: #fff; font-size: 7.5px; }
  .digital-scene__contact { display: block; margin-top: 7px; color: #6e515f; font-size: 7.5px; }
  .digital-scene__home { display: block; width: 30px; height: 2px; margin: 5px auto 0; border-radius: 2px; background: #554b50; }
  .digital-scene__connection { position: absolute; top: 44%; right: 10px; display: flex; flex-direction: column; align-items: center; gap: 5px; color: #6e515f; }
  .digital-scene__connection span { font-size: 9.5px; font-weight: 500; letter-spacing: .05em; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .digital-scene__phone { transition: transform 550ms cubic-bezier(.16, 1, .3, 1); }
    :global(.service-card:hover) .digital-scene__phone { transform: rotate(3deg) scale(1.03) translateY(-2px); }
  }
  @media (min-width: 1024px) and (max-width: 1240px) {
    .digital-scene { padding: 34px 12px 46px; }
    .digital-scene__phone { width: 112px; }
    .digital-scene__connection { top: auto; right: auto; bottom: 10px; left: 50%; transform: translateX(-50%); flex-direction: row; gap: 4px; }
    .digital-scene__connection svg { width: 20px; height: 20px; }
  }
  @media (max-width: 767px) {
    .digital-scene { min-height: 250px; height: auto; }
    .digital-scene__phone { width: 132px; }
    .digital-scene__connection { right: calc(50% - 122px); }
  }
</style>
