---
import { projects, getDemoUrl } from '../../data/projects';
import { ArrowUpRight } from 'lucide';

const items = projects.filter(project => project.type === 'client' || project.type === 'demo');
---

<div class="about-projects">
  {items.map(project => {
    const href = getDemoUrl(project.demoUrl);
    return (
      <article class="about-project" aria-labelledby={`about-project-${project.id}`}>
        <div class="about-project__image">
          <img
            src={project.image.src}
            width={project.image.width}
            height={project.image.height}
            alt={`Captura de la web ${project.title.trim()}`}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="about-project__meta">
          <span>{project.type === 'client' ? 'Proyecto de cliente' : 'Demostración de diseño'}</span>
          <span>{project.sector}</span>
        </div>
        <h3 id={`about-project-${project.id}`}>{project.title.trim()}</h3>
        {href ? (
          <a href={href} target="_blank" rel="noopener noreferrer">
            Visitar {project.title.trim()}
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {ArrowUpRight.map(([Tag, attributes]) => <Tag {...attributes} />)}
            </svg>
            <span class="sr-only"> (se abre en una pestaña nueva)</span>
          </a>
        ) : (
          <p class="about-project__preview">Vista previa de una demostración, no un proyecto de cliente.</p>
        )}
      </article>
    );
  })}
</div>

<style>
  .about-projects {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .about-project {
    min-width: 0;
  }

  .about-project__image {
    aspect-ratio: 16 / 11;
    padding: 16px;
    border: 1px solid #d9d3ca;
    border-radius: 10px;
    background: #e9e5df;
  }

  .about-project__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top;
  }

  .about-project__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 12px;
    margin-top: 18px;
    color: #655f58;
    font-size: 11px;
    line-height: 1.7;
  }

  .about-project__meta > span:first-child {
    color: #191919;
    font-weight: 550;
  }

  h3 {
    margin: 10px 0 8px;
    font-size: 21px;
    font-weight: 550;
    line-height: 1.4;
    letter-spacing: -.02em;
    overflow-wrap: anywhere;
  }

  .about-project a {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    color: #65554a;
    font-size: 13px;
    line-height: 1.6;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: #b5a89a;
  }

  .about-project a:hover {
    color: #191919;
    text-decoration-color: currentColor;
  }

  .about-project a:focus-visible {
    outline: 2px solid #65554a;
    outline-offset: 4px;
  }

  .about-project__preview {
    margin: 12px 0 0;
    color: #655f58;
    font-size: 12px;
    line-height: 1.7;
  }

  @media (max-width: 899px) {
    .about-projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 24px;
    }
  }

  @media (max-width: 599px) {
    .about-projects {
      grid-template-columns: minmax(0, 1fr);
    }

    .about-project__image {
      padding: 12px;
    }
  }
</style>
