---
import { ArrowDown } from "lucide";
import { heroScene } from "../../data/hero-scene";

// Pixel transparente 1×1: evita descargar la foto 4K del proyector en móvil/tablet (< 1024px).
const BLANK_PIXEL = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
---

<section
  class="cinematic-hero"
  aria-labelledby="hero-title"
  style={`--wall-bg-image: url(${heroScene.wallBackgroundImage});`}
>
  <div class="cinematic-hero__stage">
    <div class="cinematic-hero__camera" aria-hidden="true">
      <div class="cinematic-hero__photo">
        <picture>
          <source media="(min-width: 1024px)" srcset={heroScene.image} type="image/webp" />
          <img
            src={BLANK_PIXEL}
            width={heroScene.width}
            height={heroScene.height}
            alt=""
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <div class="cinematic-hero__bloom"></div>
    </div>
    <div class="cinematic-hero__projection" aria-hidden="true" inert></div>
    <div class="cinematic-hero__optical" aria-hidden="true"></div>
    <div class="cinematic-hero__interaction" hidden></div>
    <div class="cinematic-hero__outside">
      <div class="cinematic-hero__copy">
        <p class="cinematic-hero__eyebrow">Estudio web independiente</p>
        <h1 id="hero-title">
          Tu negocio,<br />mejor presentado.
        </h1>
        <p class="cinematic-hero__subtitle">
          Y más fácil de <span class="cinematic-hero__underline">encontrar.</span>
        </p>
        <p class="cinematic-hero__description">
          Diseño web, SEO local y soluciones digitales para conectar tu negocio
          con tus clientes.
        </p>
        <div class="cinematic-hero__actions">
          <a class="button cinematic-hero__cta-primary" href="#contacto"
            >Cuéntanos tu proyecto <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
            ></a
          >
          <a class="cinematic-hero__cta-secondary" href="#proyectos"
            >Ver nuestros trabajos <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
            ></a
          >
        </div>
      </div>
      <a class="cinematic-hero__scroll" href="#servicios">
        <span>DESLIZA HACIA ABAJO</span>
        <span class="cinematic-hero__scroll-icon" aria-hidden="true">
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {ArrowDown.map(([Tag, attributes]) => <Tag {...attributes} />)}
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  import { initCinematicHero } from "../../scripts/cinematic-hero";
  initCinematicHero();
</script>

<style>
  /* Base: modo simplificado (pared limpia de la foto original).
     Evita duplicar estilos entre SSR/móvil (< 1024px) y data-hero-mode="simplified". */
  .cinematic-hero {
    position: relative;
    z-index: 1;
  }
  .cinematic-hero__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    isolation: isolate;
    padding-top: var(--header-height);
    background-color: #d6c8b9;
    background-image:
      linear-gradient(180deg, rgb(248 247 244 / 16%) 0%, rgb(248 247 244 / 26%) 100%),
      var(--wall-bg-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .cinematic-hero__camera,
  .cinematic-hero__projection,
  .cinematic-hero__optical,
  .cinematic-hero__interaction,
  .cinematic-hero__scroll {
    display: none;
  }
  .cinematic-hero__outside {
    position: relative;
    z-index: 4;
    padding: clamp(40px, 7.5vh, 80px) var(--gutter) clamp(44px, 8vh, 84px);
    pointer-events: none;
  }
  .cinematic-hero__copy,
  .cinematic-hero__scroll {
    pointer-events: auto;
  }
  .cinematic-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: clamp(360px, 72vw, 680px);
    margin: 0 auto;
  }
  .cinematic-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 clamp(12px, 1.8vw, 18px);
    color: #36302a;
    font-size: clamp(10px, 1.1vw, 11.5px);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .cinematic-hero__eyebrow::before {
    content: "";
    display: block;
    width: 24px;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
    flex-shrink: 0;
  }
  h1 {
    margin: 0 auto;
    max-width: 14ch;
    color: var(--color-ink);
    font-size: clamp(34px, 6.2vw, 64px);
    font-weight: 550;
    line-height: 1.01;
    letter-spacing: -0.04em;
  }
  /* Terracota oficial del logotipo 7DStudio (#985233). */
  .cinematic-hero__subtitle {
    margin: clamp(10px, 1.8vw, 16px) auto 0;
    max-width: 18ch;
    color: #985233;
    font-size: clamp(21px, 3.6vw, 38px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.032em;
  }
  .cinematic-hero__underline {
    text-decoration-line: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.16em;
    text-decoration-color: currentColor;
    text-decoration-skip-ink: auto;
  }
  .cinematic-hero__description {
    max-width: 40ch;
    margin: clamp(18px, 2.4vw, 24px) auto clamp(24px, 3.2vw, 34px);
    color: #2c2722;
    font-size: clamp(15px, 1.8vw, 19px);
    line-height: 1.52;
  }
  .cinematic-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px 24px;
    width: 100%;
  }
  .cinematic-hero__cta-primary {
    min-height: clamp(50px, 5.5vw, 56px);
    padding: 13px 24px;
    gap: clamp(12px, 1.3vw, 18px);
    font-size: clamp(15px, 1.5vw, 17px);
    white-space: nowrap;
  }
  .cinematic-hero__cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    color: var(--color-ink);
    font-size: clamp(15px, 1.5vw, 17px);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-color: rgba(23, 23, 23, 0.45);
    transition: text-decoration-color 0.25s ease, color 0.25s ease;
  }
  .cinematic-hero__cta-secondary svg {
    transition: transform 0.3s ease;
  }
  .cinematic-hero__cta-secondary:hover {
    text-decoration-color: currentColor;
  }
  .cinematic-hero__cta-secondary:hover svg,
  .cinematic-hero__cta-secondary:focus-visible svg {
    transform: translate(3px, -3px);
  }

  /* Móvil estrecho (< 640px): apila verticalmente ambos CTA. */
  @media (max-width: 639px) {
    .cinematic-hero__actions {
      flex-direction: column;
      gap: 12px;
    }
    .cinematic-hero__cta-primary {
      min-height: 50px;
      padding: 13px 22px;
      font-size: 15px;
    }
    .cinematic-hero__cta-secondary {
      font-size: 15px;
    }
  }

  /* Modo cinematográfico: solo >= 1024px y cuando el espacio geométrico real es suficiente. */
  @media (min-width: 1024px) {
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__stage {
      display: block;
      height: 100svh;
      min-height: 600px;
      padding-top: 0;
      background: #f4f1eb;
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__camera,
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__projection,
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__optical,
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__interaction {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      transform-origin: 0 0;
      pointer-events: none;
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__camera {
      inset: 0;
      z-index: 0;
    }
    /* Respaldo sin JS: encuadra la fotografía bajo el header fijo. */
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__photo {
      position: absolute;
      inset: var(--header-height) 0 0;
      pointer-events: none;
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__photo picture,
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__photo img {
      display: block;
      width: 100%;
      height: 100%;
      max-width: none;
      object-fit: cover;
      object-position: 50% 45%;
    }
    /* Halo luminoso arquitectónico alrededor de la superficie proyectada en pared. */
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__bloom {
      position: absolute;
      top: 0;
      left: 0;
      opacity: 0;
      pointer-events: none;
      box-shadow:
        0 0 34px rgb(255 252 245 / 48%),
        0 0 8px rgb(255 253 249 / 34%);
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__projection {
      z-index: 1;
      overflow: hidden;
      background: #f4f1eb;
      visibility: hidden;
    }
    /* Tratamiento óptico discreto (compositor-only, sin blur): caída direccional de luz
       desde el proyector (abajo-derecha) e integración suave con el borde del yeso. */
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__optical {
      z-index: 2;
      opacity: 0;
      background:
        radial-gradient(
          ellipse 95% 90% at 72% 84%,
          rgb(255 251 244 / 10%) 0%,
          rgb(255 251 244 / 0%) 52%,
          rgb(162 148 132 / 16%) 100%
        ),
        linear-gradient(
          155deg,
          rgb(176 162 146 / 7%) 0%,
          rgb(255 252 246 / 0%) 45%,
          rgb(255 248 236 / 9%) 100%
        );
      box-shadow: inset 0 0 26px rgb(224 214 202 / 56%);
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__interaction {
      z-index: 3;
      overflow: hidden;
    }
    .cinematic-hero__interaction :global(.cinematic-hero__interaction-inner) {
      position: relative;
      transform-origin: 50% 0;
      pointer-events: none;
    }
    .cinematic-hero__interaction :global(a) {
      position: absolute;
      display: block;
      pointer-events: auto;
      cursor: pointer;
    }
    .cinematic-hero__interaction :global(a:focus-visible) {
      outline: 3px solid #171717;
      outline-offset: -4px;
    }
    .cinematic-hero__projection :global(.cinematic-hero__replica) {
      transform-origin: 50% 0;
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__outside {
      display: grid;
      grid-template-columns: var(--projection-left, 42.5%) minmax(0, 1fr);
      align-items: center;
      height: 100%;
      padding: var(--header-height) 0 clamp(58px, 8svh, 88px);
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__copy {
      grid-column: 1;
      justify-self: end;
      display: block;
      width: fit-content;
      max-width: calc(100% - var(--gutter) - clamp(26px, 3.4vw, 60px));
      margin: 0 clamp(26px, 3.4vw, 60px) 0 var(--gutter);
      text-align: left;
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__eyebrow {
      margin: 0 0 clamp(8px, 1.3svh, 14px);
      color: #3a342e;
      font-size: 11px;
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) h1 {
      margin: 0;
      width: max-content;
      max-width: 100%;
      font-size: clamp(32px, min(4.1vw, 7.4svh), 78px);
      line-height: 0.96;
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__subtitle {
      margin: clamp(8px, 1.5svh, 16px) 0 0;
      max-width: none;
      font-size: clamp(22px, min(2.8vw, 4.6svh), 48px);
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__description {
      max-width: 28ch;
      margin: clamp(12px, 2svh, 22px) 0 clamp(14px, 2.6svh, 28px);
      color: #312c27;
      font-size: clamp(15px, min(1.4vw, 2.25svh), 21px);
      line-height: 1.48;
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__actions {
      justify-content: flex-start;
      width: auto;
      gap: clamp(10px, 1.4svh, 14px) clamp(16px, 1.8vw, 24px);
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__cta-primary {
      min-height: clamp(46px, 5.6svh, 58px);
      padding: clamp(11px, 1.5svh, 16px) clamp(18px, 1.9vw, 26px);
      font-size: clamp(15px, min(1.25vw, 1.95svh), 18px);
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__cta-secondary {
      font-size: clamp(15px, min(1.25vw, 1.95svh), 18px);
    }
    /* Cápsula flotante «DESLIZA HACIA ABAJO» con icono Lucide en círculo blanco. */
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__scroll {
      position: absolute;
      left: 50%;
      bottom: clamp(18px, 3.6svh, 38px);
      transform: translateX(-50%);
      display: inline-flex;
      align-items: center;
      gap: 12px;
      min-height: 44px;
      padding: 7px 8px 7px 18px;
      border-radius: 999px;
      background: rgb(23 23 23 / 84%);
      color: #ffffff;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.14em;
      white-space: nowrap;
      box-shadow: 0 6px 20px rgb(23 23 23 / 16%);
      transition: background-color 0.25s ease, box-shadow 0.25s ease;
    }
    @supports ((backdrop-filter: blur(8px)) or (-webkit-backdrop-filter: blur(8px))) {
      .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__scroll {
        background: rgb(23 23 23 / 78%);
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
      }
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__scroll:hover {
      background: rgb(23 23 23 / 94%);
      box-shadow: 0 8px 24px rgb(23 23 23 / 22%);
    }
    .cinematic-hero:not([data-hero-mode="simplified"]) .cinematic-hero__scroll:focus-visible {
      outline: 2px solid var(--color-ink);
      outline-offset: 4px;
    }
    .cinematic-hero__scroll-icon {
      display: grid;
      place-items: center;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #ffffff;
      color: #171717;
      flex-shrink: 0;
    }
  }

  /* Estados cinematográficos activos */
  .cinematic-hero.cinematic-projected .cinematic-hero__projection {
    visibility: visible;
  }
  .cinematic-hero.cinematic-ready .cinematic-hero__stage {
    min-height: 0;
  }
  .cinematic-hero.cinematic-ready:not(.cinematic-complete) .cinematic-hero__camera,
  .cinematic-hero.cinematic-ready:not(.cinematic-complete) .cinematic-hero__projection {
    will-change: transform, opacity;
  }
  .cinematic-hero.cinematic-complete .cinematic-hero__stage {
    visibility: hidden;
  }
  .cinematic-hero.cinematic-complete {
    visibility: hidden;
    pointer-events: none;
  }
  :global(.cinematic-ready ~ .services-surface) {
    margin-top: -100svh;
  }
  :global(.cinematic-ready ~ .services-surface #servicios) {
    scroll-margin-top: calc(-1 * (var(--header-height) + 24px));
  }

  /* Animaciones de entrada y flecha (respetando prefers-reduced-motion) */
  @keyframes scroll-arrow-nudge {
    0%, 100% {
      transform: translateY(-1.5px);
    }
    50% {
      transform: translateY(2px);
    }
  }
  @keyframes hero-reveal {
    from {
      opacity: 0.01;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cinematic-hero__eyebrow {
      animation: hero-reveal 0.45s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }
    h1 {
      animation: hero-reveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.06s backwards;
    }
    .cinematic-hero__subtitle {
      animation: hero-reveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.12s backwards;
    }
    .cinematic-hero__description {
      animation: hero-reveal 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.18s backwards;
    }
    .cinematic-hero__actions {
      animation: hero-reveal 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.22s backwards;
    }
    .cinematic-hero__scroll {
      animation: hero-reveal 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.28s backwards;
    }
    .cinematic-hero__scroll-icon svg {
      animation: scroll-arrow-nudge 2.2s ease-in-out infinite;
    }
  }
</style>
