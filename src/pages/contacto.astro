---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Contact from "../components/home/Contact.astro";
import { site } from "../data/site";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "Contacto en Castellón · 7DStudio",
    url: `${site.url}/contacto/`,
    description:
      "Contacta con 7DStudio en Castellón de la Plana. Pide presupuesto sin compromiso para diseño web, SEO local o placas QR/NFC por formulario o WhatsApp.",
    about: { "@id": `${site.url}/#business` },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${site.url}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Contacto",
        item: `${site.url}/contacto/`,
      },
    ],
  },
];
---

<BaseLayout
  title="Contacto en Castellón | Presupuesto web y SEO · 7DStudio"
  description="Contacta con 7DStudio en Castellón de la Plana. Pide presupuesto sin compromiso para diseño web, SEO local o placas QR/NFC por formulario o WhatsApp."
  structuredData={structuredData}
>
  <Header />
  <main id="contenido" class="contact-page">
    <section
      class="contact-hero container"
      aria-labelledby="contact-page-title"
    >
      <nav class="contact-breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a><span aria-hidden="true">/</span><span
          aria-current="page">Contacto</span>
      </nav>
      <p class="contact-hero__label">CONTACTO EN CASTELLÓN / 7DStudio</p>
      <h1 id="contact-page-title">Hablemos de <span class="heading-emphasis">tu proyecto.</span></h1>
      <p class="contact-hero__description">
        Trabajamos desde Castellón de la Plana con autónomos, comercios y pymes
        de toda la provincia y en remoto. Cuéntanos si necesitas una página web,
        mejorar tu visibilidad en Google Maps o preparar productos QR/NFC.
      </p>
      <nav class="contact-shortcuts" aria-label="Accesos rápidos antes de escribir">
        <a href="/diseno-web/#presupuesto">Calcular presupuesto web <span aria-hidden="true">↗</span></a>
        <a href="/seo-local/#planes">Ver planes de SEO local <span aria-hidden="true">↗</span></a>
        <a href="/productos/">Explorar productos QR y NFC <span aria-hidden="true">↗</span></a>
        <a href="/preguntas-frecuentes/">Preguntas frecuentes <span aria-hidden="true">↗</span></a>
      </nav>
    </section>
    <Contact
      mode="contact"
      variant="pearl"
      title="Cuéntanos qué necesitas."
      description="Explícanos qué negocio tienes y qué te gustaría resolver. Te ayudamos a concretar el siguiente paso, sin necesidad de tenerlo todo decidido."
    >
      <Fragment slot="title">Cuéntanos <span class="heading-quiet">qué necesitas.</span></Fragment>
    </Contact>
  </main>
  <Footer />
</BaseLayout>
<style>
  .contact-page {
    padding-top: var(--header-height);
    padding-bottom: 56px;
    background: #f7f5f3;
  }
  .contact-hero {
    padding-block: 28px 48px;
  }
  .contact-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 38px;
    color: #655f58;
    font-size: 12px;
    line-height: 1.7;
  }
  .contact-breadcrumb a:hover {
    text-decoration: underline;
  }
  .contact-hero__label {
    margin: 0 0 20px;
    color: #655f58;
    font-size: 12px;
    line-height: 1.6;
    letter-spacing: 0.08em;
  }
  h1 {
    margin: 0;
    max-width: 20ch;
    font-size: clamp(40px, 5vw, 68px);
    font-weight: 480;
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .contact-hero__description {
    max-width: 65ch;
    margin: 24px 0 0;
    color: #655f58;
    font-size: 17px;
    line-height: 1.8;
  }
  .contact-shortcuts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 22px;
  }
  .contact-shortcuts a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: #554d46;
    font-size: 14px;
    font-weight: 550;
    line-height: 1.5;
    text-decoration: underline;
    text-decoration-color: #c2b8ae;
    text-underline-offset: 4px;
  }
  .contact-shortcuts a:hover {
    color: #191919;
    text-decoration-color: currentColor;
  }
  @media (max-width: 599px) {
    .contact-hero {
      padding-block: 22px 34px;
    }
    .contact-breadcrumb {
      margin-bottom: 28px;
    }
    .contact-hero__label {
      font-size: 11px;
    }
    .contact-hero__description {
      font-size: 15px;
    }
    .contact-page {
      padding-bottom: 32px;
    }
  }
</style>
