---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import WebProjects from "../components/web-design/WebProjects.astro";
import WebCalculator from "../components/web-design/WebCalculator.astro";
import WebContact from "../components/web-design/WebContact.astro";
import WebHeroMockup from "../components/web-design/WebHeroMockup.astro";
import {
  ShieldCheck,
  LayoutTemplate,
  MousePointerClick,
  Smartphone,
  Check,
  Minus,
  Search,
  MessageCircle,
  Store,
} from "lucide";
import { site } from "../data/site";
import { webPricing, formatWebPrice } from "../data/webPricing";
import "../styles/web-design.css";

const benefits = [
  {
    title: "Transmite confianza",
    text: "Una presentación cuidada ayuda a que tus clientes conozcan mejor tu negocio.",
    icon: ShieldCheck,
  },
  {
    title: "Explica tus servicios",
    text: "Toda la información importante, organizada para que sea fácil de entender.",
    icon: LayoutTemplate,
  },
  {
    title: "Facilita el contacto",
    text: "WhatsApp, teléfono y formularios accesibles para que puedan hablar contigo.",
    icon: MousePointerClick,
  },
  {
    title: "Se adapta a cualquier pantalla",
    text: "Tu negocio se verá correctamente en móvil, tablet y ordenador.",
    icon: Smartphone,
  },
];
const process = [
  {
    title: "Nos cuentas tu idea",
    text: "Hablamos de tu negocio, tus clientes y qué necesitas conseguir con la web.",
  },
  {
    title: "Diseñamos y desarrollamos",
    text: "Organizamos el contenido y creamos una web adaptada a tu negocio.",
  },
  {
    title: "Revisamos y publicamos",
    text: "Comprobamos que todo funcione en móvil y ordenador antes de publicarla.",
  },
];
const situations = [
  {
    id: "scattered",
    title: "Información dispersa",
    label: "CUESTA CONOCERTE",
    points: [
      "Servicios difíciles de encontrar.",
      "Información repartida.",
      "Contacto poco visible.",
    ],
    icon: Minus,
  },
  {
    id: "clear",
    title: "Una web bien diseñada",
    label: "TODO EN SU SITIO",
    points: [
      "Servicios claros y organizados.",
      "Todo en un mismo lugar.",
      "Contacto rápido y sencillo.",
    ],
    icon: Check,
  },
];
// Lucide instalado no incluye marcas: contorno de Instagram sin dependencia adicional.
const instagramIcon: typeof Search = [
  ["rect", { x: "2", y: "2", width: "20", height: "20", rx: "5" }],
  ["circle", { cx: "12", cy: "12", r: "4" }],
  ["path", { d: "M17.5 6.5h.01" }],
];
const channels = [
  {
    name: "Instagram",
    text: "Fotos y publicaciones, pero pocos detalles.",
    icon: instagramIcon,
  },
  { name: "Google", text: "Horarios y ubicación.", icon: Search },
  {
    name: "WhatsApp",
    text: "Preguntar por los servicios.",
    icon: MessageCircle,
  },
];
const faqs = [
  {
    question: "¿Qué necesito para tener una página web?",
    answer:
      "Empezamos con información sobre tu negocio, tus servicios y las imágenes o materiales que tengas. Definimos contigo qué falta y qué alcance necesita el proyecto.",
    questionStrong: ['Qué necesito', 'página web'],
    answerStrong: ['información sobre tu negocio', 'imágenes o materiales', 'qué alcance necesita el proyecto'],
  },
  {
    question: "¿Cuánto cuesta crear una web para mi negocio?",
    answer: `La referencia para una web de una página es de ${formatWebPrice(webPricing.types[0].baseCents!)} + IVA. Si necesitas varias páginas o funcionalidades adicionales, puedes calcular un precio orientativo con nuestra calculadora. Después revisaremos contigo los detalles para confirmar el presupuesto.`,
    questionStrong: ['Cuánto cuesta'],
    answerStrong: [`${formatWebPrice(webPricing.types[0].baseCents!)} + IVA`, 'precio orientativo con nuestra calculadora', 'confirmar el presupuesto'],
  },
  {
    question: "¿Tengo que pagar todos los meses?",
    answer:
      "El diseño y desarrollo de la web se paga como un proyecto. El dominio y el alojamiento pueden tener costes periódicos, mientras que el mantenimiento y los servicios de SEO se contratan por separado. Te explicaremos todos los costes antes de empezar.",
    questionStrong: ['pagar todos los meses'],
    answerStrong: ['se paga como un proyecto', 'dominio y el alojamiento', 'se contratan por separado'],
  },
  {
    question:
      "¿Qué diferencia hay entre una web de una página y una web corporativa?",
    answer:
      "La primera reúne la información en una única página. Una corporativa reparte servicios, empresa y contacto en varias páginas. La elección depende del contenido que necesites presentar.",
    questionStrong: ['web de una página', 'web corporativa'],
    answerStrong: ['una única página', 'varias páginas', 'contenido que necesites presentar'],
  },
  {
    question: "¿Mi web funcionará en el móvil?",
    answer:
      "Sí. Adaptamos el diseño a móvil, tablet y ordenador, y revisamos la navegación y las formas de contacto en diferentes tamaños de pantalla.",
    questionStrong: ['funcionará en el móvil'],
    answerStrong: ['Sí.', 'móvil, tablet y ordenador', 'navegación y las formas de contacto'],
  },
  {
    question: "¿Podré solicitar cambios después?",
    answer:
      "Por supuesto. Si más adelante necesitas actualizar información, añadir servicios o ampliar tu web, podemos ayudarte. Te indicaremos el presupuesto antes de realizar cualquier modificación.",
    questionStrong: ['solicitar cambios después'],
    answerStrong: ['actualizar información, añadir servicios o ampliar tu web', 'presupuesto antes de realizar cualquier modificación'],
  },
  {
    question: "¿Mi página aparecerá en Google?",
    answer:
      "Preparamos la web para que los buscadores puedan entenderla. La indexación y el posicionamiento dependen de varios factores: no garantizamos posiciones. Si necesitas seguimiento, podemos valorar el servicio de SEO local.",
    questionStrong: ['aparecerá en Google'],
    answerStrong: ['los buscadores puedan entenderla', 'no garantizamos posiciones', 'SEO local'],
  },
  {
    question: "¿Qué ocurre si no sé qué tipo de web necesito?",
    answer:
      "No necesitas llegar con todo decidido. Cuéntanos qué hace tu negocio y qué te gustaría conseguir; te ayudamos a elegir una opción adecuada antes de cerrar el presupuesto.",
    questionStrong: ['no sé qué tipo de web necesito'],
    answerStrong: ['No necesitas llegar con todo decidido.', 'te ayudamos a elegir una opción adecuada'],
  },
];
function emphasizeFaqText(text: string, phrases: readonly string[]) {
  const pattern = phrases.map(phrase => phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
  return text.split(new RegExp(`(${pattern})`, 'g')).filter(Boolean).map(part => ({
    text: part,
    tag: phrases.includes(part) ? 'strong' as const : 'span' as const,
  }));
}
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: site.url },
      {
        "@type": "ListItem",
        position: 2,
        name: "Diseño web",
        item: `${site.url}/diseno-web/`,
      },
    ],
  },
];
---

<BaseLayout
  title="Diseño web en Castellón para negocios | 7D Studio"
  description="Páginas web profesionales para autónomos, pequeños negocios y pymes. Explora nuestros proyectos y calcula un presupuesto orientativo para tu web."
  structuredData={structuredData}
>
  <Header />
  <main id="contenido" class="web-page">
    <section class="web-hero container" aria-labelledby="web-title">
      <nav class="web-breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a><span aria-hidden="true">/</span><span
          aria-current="page">Diseño web</span
        >
      </nav>
      <div class="web-hero__layout">
        <div class="web-hero__copy">
          <p class="web-eyebrow">DISEÑO WEB / 7D STUDIO</p>
          <h1 id="web-title">
            Tu negocio merece una web que <span>lo represente de verdad.</span>
          </h1>
          <p class="web-hero__description">
            Diseñamos páginas web profesionales para que tus clientes entiendan
            qué haces, confíen en tu negocio y puedan contactar contigo
            fácilmente.
          </p>
          <a class="button" href="#presupuesto"
            >Calcula tu presupuesto <span aria-hidden="true">↗</span></a
          >
          <a class="web-text-link web-hero__secondary" href="#proyectos"
            >Ver nuestros proyectos <span aria-hidden="true">↓</span></a
          >
          <a
            class="web-text-link web-hero__help"
            href={site.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            >¿No sabes qué web necesitas? Hablemos <span aria-hidden="true"
              >↗</span
            ><span class="sr-only">
              por WhatsApp (se abre en una pestaña nueva)</span
            ></a
          >
        </div>
        <WebHeroMockup />
      </div>
    </section>

    <section
      class="web-problem web-section container"
      aria-labelledby="web-problem-title"
    >
      <div class="web-heading">
        <p class="web-eyebrow">LO QUE VE TU CLIENTE</p><h2
          id="web-problem-title"
        >
          Tu negocio puede ser excelente. Tu web debería reflejarlo.
        </h2><p>
          Cuando alguien descubre tu empresa, quiere saber qué haces, qué
          servicios ofreces y cómo contactar contigo. Si esa información no está
          clara, puede seguir buscando otras opciones.
        </p>
      </div>
      <div class="web-comparison">
        {
          situations.map((situation) => (
            <article
              class:list={["web-situation", `web-situation--${situation.id}`]}
            >
              <>
                <p class="web-eyebrow">{situation.label}</p>
                <h3>{situation.title}</h3>
              </>
              <div
                class:list={["web-interface", `web-interface--${situation.id}`]}
              >
                {situation.id === "scattered" ? (
                  channels.map((channel) => (
                    <div class="web-channel">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        {channel.icon.map(([Tag, attributes]) => (
                          <Tag {...attributes} />
                        ))}
                      </svg>
                      <div>
                        <strong>{channel.name}</strong>
                        <p>{channel.text}</p>
                      </div>
                    </div>
                  ))
                ) : (
                  <>
                    <div class="web-interface__nav">
                      <b>TU NEGOCIO</b>
                      <span>Servicios · Contacto</span>
                    </div>
                    <div class="web-interface__body">
                      <div>
                        <strong>
                          Todo claro.
                          <br />
                          En un solo lugar.
                        </strong>
                        <p>Tus servicios, tu trabajo y cómo contactar.</p>
                        <span class="web-interface__cta">
                          Contactar <span aria-hidden="true">↗</span>
                        </span>
                      </div>
                      <div class="web-interface__visual" aria-hidden="true">
                        <svg
                          width="80"
                          height="80"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          {Store.map(([Tag, attributes]) => (
                            <Tag {...attributes} />
                          ))}
                        </svg>
                      </div>
                    </div>
                  </>
                )}
              </div>
              <ul role="list">
                {situation.points.map((point) => (
                  <li>
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      {situation.icon.map(([Tag, attributes]) => (
                        <Tag {...attributes} />
                      ))}
                    </svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="web-caption">
        Ejemplo ilustrativo de cómo una web puede organizar mejor la información
        de un negocio.
      </p>
    </section>

    <section
      class="web-benefits web-section"
      aria-labelledby="web-benefits-title"
    >
      <div class="container">
        <div class="web-heading">
          <p class="web-eyebrow">MÁS QUE ESTAR ONLINE</p><h2
            id="web-benefits-title"
          >
            Una web que presenta tu negocio como se merece.
          </h2>
        </div>
        <div class="web-benefits__grid">
          {
            benefits.map((benefit) => (
              <article>
                <>
                  <svg
                    width="30"
                    height="30"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    {benefit.icon.map(([Tag, attributes]) => (
                      <Tag {...attributes} />
                    ))}
                  </svg>
                  <h3>{benefit.title}</h3>
                  <p>{benefit.text}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="web-process web-section container"
      aria-labelledby="web-process-title"
    >
      <div class="web-heading">
        <p class="web-eyebrow">ASÍ TRABAJAMOS</p><h2 id="web-process-title">
          De tu idea a una web lista para tus clientes.
        </h2>
      </div><ol>
        {
          process.map((step, index) => (
            <li>
              <div class="web-process__visual" aria-hidden="true">
                <span class="web-process__number" aria-hidden="true">
                  0{index + 1}
                </span>
                <svg
                  class="web-process__illustration"
                  width="180"
                  height="100"
                  viewBox="0 0 180 100"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                >
                  {index === 0 ? (
                    <>
                      <path
                        d="M26 12h82a8 8 0 0 1 8 8v32a8 8 0 0 1-8 8H48L30 72V60h-4a8 8 0 0 1-8-8V20a8 8 0 0 1 8-8Z"
                        fill="var(--web-surface)"
                      />
                      <path
                        d="M78 40h76a8 8 0 0 1 8 8v28a8 8 0 0 1-8 8h-7v10l-16-10H78a8 8 0 0 1-8-8V48a8 8 0 0 1 8-8Z"
                        fill="var(--web-beige)"
                      />
                      <path d="M34 28h56M34 38h24M86 56h58M86 66h40" />
                    </>
                  ) : (
                    <>
                      <rect
                        x="18"
                        y="8"
                        width="144"
                        height="84"
                        rx="7"
                        fill="var(--web-surface)"
                      />
                      <path d="M18 25h144" />
                      <g fill="currentColor" stroke="none">
                        <circle cx="29" cy="17" r="1.5" />
                        <circle cx="36" cy="17" r="1.5" />
                        <circle cx="43" cy="17" r="1.5" />
                      </g>
                      {index === 1 ? (
                        <>
                          <rect
                            x="30"
                            y="37"
                            width="38"
                            height="42"
                            rx="3"
                            fill="var(--web-beige)"
                          />
                          <rect
                            x="80"
                            y="37"
                            width="70"
                            height="17"
                            rx="3"
                            fill="var(--web-beige)"
                          />
                          <path d="M80 65h70M80 75h46" />
                          <path d="M40 48h18M40 57h12" />
                        </>
                      ) : (
                        <>
                          <circle
                            cx="90"
                            cy="58"
                            r="23"
                            fill="var(--web-beige)"
                          />
                          <path d="m79 58 7 7 15-15" stroke-width="2" />
                        </>
                      )}
                    </>
                  )}
                </svg>
              </div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </section>
    <WebProjects />
    <WebCalculator />

    <section
      id="preguntas-web"
      class="web-faq web-section container"
      aria-labelledby="web-faq-title"
    >
      <div class="web-heading">
        <p class="web-eyebrow">ANTES DE EMPEZAR</p><h2 id="web-faq-title">
          Tu próxima web,<br />sin dudas pendientes.
        </h2><p>Lo importante, explicado sin tecnicismos.</p><a
          class="web-text-link"
          href="/seo-local/"
          >¿También quieres mejorar tu presencia local? <span aria-hidden="true"
            >↗</span
          ></a
        >
      </div>
      <div>
        {
          faqs.map((faq) => (
            <details>
              <>
                <summary>
                  <>
                     <span>{emphasizeFaqText(faq.question, faq.questionStrong).map(({ text, tag: Tag }) => <Tag>{text}</Tag>)}</span>
                    <span class="web-faq__indicator" aria-hidden="true" />
                  </>
                </summary>
                 <p>{emphasizeFaqText(faq.answer, faq.answerStrong).map(({ text, tag: Tag }) => <Tag>{text}</Tag>)}</p>
              </>
            </details>
          ))
        }
      </div>
    </section>
    <WebContact />
  </main>
  <Footer />
</BaseLayout>
