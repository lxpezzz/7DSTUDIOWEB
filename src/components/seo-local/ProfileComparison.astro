---
import { ImageOff, CircleMinus, CircleCheck } from 'lucide';
import AdvisoryFacade from '../../images/seo-local/advisory-facade.svg';
import AdvisoryInterior from '../../images/seo-local/advisory-interior.svg';
import AdvisoryConsultation from '../../images/seo-local/advisory-consultation.svg';

const profiles = [
  {
    id: 'before',
    label: 'Ficha descuidada',
    description: 'Asesoría.',
    indicatorIcon: CircleMinus,
    indicators: [
      'Servicios sin detallar.',
      'Horarios sin actualizar.',
      'Contacto poco claro.',
    ],
  },
  {
    id: 'after',
    label: 'Ficha bien trabajada',
    description: 'Asesoría fiscal, laboral y contable.',
    indicatorIcon: CircleCheck,
    indicators: [
      'Servicios explicados.',
      'Horarios actualizados.',
      'Contacto fácil de encontrar.',
    ],
  },
];
---

<section class="comparison container" aria-labelledby="comparison-title">
  <div class="comparison__heading">
    <p class="comparison__label">LA MISMA EMPRESA. OTRA PRESENTACIÓN.</p>
    <h2 id="comparison-title">¿Tu ficha ayuda a elegirte?</h2>
    <p>La información que muestras puede marcar la diferencia cuando un cliente compara negocios.</p>
  </div>
  <div class="comparison__grid">
    {profiles.map((profile) => (
      <article class:list={['profile', `profile--${profile.id}`]} aria-labelledby={`profile-${profile.id}`}>
        <h3 id={`profile-${profile.id}`}>{profile.label}</h3>
        <div class="profile__sheet">
          <div class="profile__visual">
            {profile.id === 'before' ? (
              <>
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {ImageOff.map(([Tag, attributes]) => <Tag {...attributes} />)}
                </svg>
                <span class="profile__visual-label">Sin fotografías del negocio</span>
              </>
            ) : (
              <>
                <div class="profile__gallery">
                  <div class="profile__thumbnail">
                    <div class="profile__scene">
                      <AdvisoryFacade role="img" aria-label="Ilustración de la fachada de una asesoría ficticia, con puerta de cristal y ventanales" />
                      <span class="profile__sign" aria-hidden="true">ASESORÍA</span>
                    </div>
                  </div>
                  <div class="profile__thumbnail">
                    <div class="profile__scene">
                      <AdvisoryInterior role="img" aria-label="Ilustración del interior de la misma asesoría ficticia: mesa, ordenador, silla, estantería y planta" />
                    </div>
                  </div>
                  <div class="profile__thumbnail">
                    <div class="profile__scene">
                      <AdvisoryConsultation role="img" aria-label="Ilustración de atención al cliente en la misma asesoría ficticia, con dos personas ante un escritorio" />
                    </div>
                  </div>
                </div>
                <span class="profile__visual-label">Fachada · Interior · Atención</span>
              </>
            )}
          </div>
          <div class="profile__info">
            <p class="profile__name">Asesoría de ejemplo</p>
            <p class="profile__description">{profile.description}</p>
            <ul class="profile__indicators" role="list">
              {profile.indicators.map((indicator) => (
                <li>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {profile.indicatorIcon.map(([Tag, attributes]) => <Tag {...attributes} />)}
                  </svg>
                  <span>{indicator}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>
    ))}
  </div>
  <p class="comparison__disclaimer">Ejemplo ilustrativo. Mejorar una ficha no garantiza posiciones en Google.</p>
</section>

<style>
  .comparison {
    padding-block: 72px;
  }
  .comparison__heading {
    max-width: 800px;
    margin-bottom: 28px;
  }
  .comparison__label {
    margin: 0 0 10px;
    color: #59674f;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.6;
  }
  h2 {
    margin: 0;
    font-size: clamp(30px, 3.3vw, 46px);
    font-weight: 450;
    line-height: 1.13;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .comparison__heading > p:last-child {
    margin: 14px 0 0;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .comparison__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .profile {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 380px;
    padding: 18px;
    border: 1px solid #e0d9d2;
    border-radius: 14px;
    background: #eeebe7;
    color: #626158;
  }
  .profile--after {
    border-color: #ccd7c4;
    background: #e3e9dd;
    color: #47563e;
  }
  h3 {
    margin: 0 0 14px;
    color: var(--color-ink);
    font-size: 21px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }
  .profile__sheet {
    display: flex;
    flex: 1;
    flex-direction: column;
    border: 1px solid #e0d9d2;
    border-radius: 9px;
    background: #fff;
  }
  .profile--after .profile__sheet {
    border-color: #ccd7c4;
  }
  .profile__visual {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 126px;
    padding: 8px;
    border-radius: 8px 8px 0 0;
    background: #f2f0ed;
    color: #898178;
  }
  .profile--before .profile__visual {
    border: 1px dashed #c8c0b6;
  }
  .profile--after .profile__visual {
    background: #dae2d4;
    color: #607858;
  }
  .profile__visual-label {
    color: #626158;
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
  }
  .profile--after .profile__visual-label {
    color: #47563e;
  }
  .profile__gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    width: 100%;
    height: 86px;
  }
  .profile__thumbnail {
    display: grid;
    place-items: center;
    min-width: 0;
    border: 1px solid #ccd7c4;
    border-radius: 5px;
    background: #f8f7f4;
  }
  .profile__scene {
    position: relative;
    width: 100%;
    max-width: 108px;
    aspect-ratio: 144 / 112;
  }
  .profile__scene > svg {
    width: 100%;
    height: auto;
  }
  .profile__sign {
    position: absolute;
    top: 18%;
    left: 50%;
    transform: translateX(-50%);
    padding: 1px 4px;
    border-radius: 1px;
    background: #617858;
    color: #f8f7f4;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.4;
  }
  .profile__info {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 16px;
  }
  .profile__name {
    margin: 0 0 4px;
    color: var(--color-ink);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }
  .profile__description {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
  }
  .profile__indicators {
    display: grid;
    gap: 6px;
    margin: auto 0 0;
    padding: 16px 0 0;
    list-style: none;
  }
  .profile__indicators > li {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 24px;
    font-size: 14px;
    line-height: 1.5;
  }
  .profile__indicators svg {
    color: #b68d73;
  }
  .profile--after .profile__indicators svg {
    color: #607858;
  }
  .comparison__disclaimer {
    margin: 18px 0 0;
    color: var(--color-muted);
    font-size: 12px;
    line-height: 1.7;
  }
  @media (max-width: 1023px) {
    .comparison__grid {
      gap: 20px;
    }
    .profile {
      padding: 16px;
    }
    .profile__info {
      padding: 14px;
    }
  }
  @media (max-width: 767px) {
    .comparison {
      padding-block: 48px;
    }
    .comparison__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
