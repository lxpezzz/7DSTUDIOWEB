---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import SeoContact from "../components/seo-local/SeoContact.astro";
import SearchPreview from "../components/seo-local/SearchPreview.astro";
import ProfileComparison from "../components/seo-local/ProfileComparison.astro";
import SeoPlans from "../components/seo-local/SeoPlans.astro";
import {
  Search,
  Store,
  Phone,
  MessageCircle,
  SearchCheck,
  FilePenLine,
  Star,
  ChartNoAxesColumnIncreasing,
} from "lucide";
import { site } from "../data/site";

const title = "SEO local en Castellón | 7D Studio";
const description =
  "Ayudamos a negocios a mejorar su presencia en Google. Descubre cómo trabajamos el SEO local y consulta nuestros planes Estándar y Premium.";
const contactUrl = new URL(site.whatsapp);
contactUrl.searchParams.set(
  "text",
  "Hola, me gustaría mejorar la visibilidad local de mi negocio. ¿Podemos hablar?",
);
const contactHref = contactUrl.href;
const work = [
  {
    id: "analysis",
    icon: SearchCheck,
    label: "TU PUNTO DE PARTIDA",
    title: "Analizamos tu presencia",
    text: "Revisamos cómo aparece tu negocio en Google y detectamos oportunidades de mejora.",
  },
  {
    id: "information",
    icon: FilePenLine,
    label: "INFORMACIÓN QUE AYUDA",
    title: "Mejoramos tu información",
    text: "Cuidamos tus servicios, horarios, fotografías y datos para que tus clientes encuentren lo que necesitan.",
  },
  {
    id: "reviews",
    icon: Star,
    label: "CONFIANZA Y REPUTACIÓN",
    title: "Cuidamos tus reseñas",
    text: "Respondemos a las reseñas de Google de forma profesional y personalizada, cuidando la imagen de tu negocio.",
  },
  {
    id: "tracking",
    icon: ChartNoAxesColumnIncreasing,
    label: "SEGUIMIENTO",
    title: "Revisamos la evolución",
    text: "Analizamos las visualizaciones, interacciones y otros datos disponibles para conocer cómo evoluciona tu presencia local.",
  },
];
interface FaqItem {
  question: string;
  answer: string | string[];
  questionStrong: string[];
  answerStrong: string[];
  answerItalic?: string[];
}

const faqs: FaqItem[] = [
  {
    question: "¿Necesito tener una página web para contratar SEO local?",
    answer:
      "No necesariamente. Podemos empezar mejorando tu Perfil de Empresa en Google, aunque no tengas web. Si dispones de una, también podemos trabajar determinados aspectos para reforzar tu presencia online.",
    questionStrong: ["página web"],
    answerStrong: ["No necesariamente.", "Perfil de Empresa en Google"],
  },
  {
    question: "¿Cuánto tiempo se tarda en notar resultados?",
    answer: [
      "El SEO local es una carrera de fondo, no un sprint. Algunas mejoras pueden apreciarse rápidamente, pero conseguir una presencia más sólida en Google requiere tiempo, constancia y seguimiento.",
      "Por eso, recomendamos trabajar durante un mínimo de 6 meses, para poder evaluar la evolución y realizar los ajustes necesarios.",
      "Los resultados dependen de cada negocio, su competencia y su situación inicial, por lo que no garantizamos posiciones ni plazos concretos.",
    ],
    questionStrong: ["notar resultados"],
    answerStrong: ["tiempo, constancia y seguimiento", "mínimo de 6 meses", "no garantizamos posiciones ni plazos concretos"],
    answerItalic: ["una carrera de fondo, no un sprint"],
  },
  {
    question: "¿Qué diferencia hay entre SEO Estándar y Premium?",
    answer:
      "Estándar se centra en mantener y mejorar tu presencia local en Google. Premium incluye todo lo anterior y amplía el trabajo con SEO On-Page mensual, directorios profesionales, análisis de competencia y un seguimiento más detallado.",
    questionStrong: ["SEO Estándar y Premium"],
    answerStrong: ["Estándar", "Premium incluye todo lo anterior", "SEO On-Page mensual"],
  },
  {
    question: "¿Qué necesitáis para empezar a trabajar con mi negocio?",
    answer:
      "Necesitaremos acceso autorizado a tu Perfil de Empresa de Google. Para las mejoras que afecten a tu página web, también necesitaremos permisos de edición. Te explicaremos cómo concedernos acceso de forma segura.",
    questionStrong: ["Qué necesitáis"],
    answerStrong: ["acceso autorizado", "permisos de edición"],
    answerItalic: ["de forma segura"],
  },
  {
    question: "¿También os encargáis de responder a las reseñas de Google?",
    answer:
      "Sí. Nos encargamos de gestionar y preparar respuestas personalizadas a las reseñas, siguiendo el tono de tu negocio. El alcance concreto dependerá del plan contratado.",
    questionStrong: ["responder a las reseñas de Google"],
    answerStrong: ["Sí.", "respuestas personalizadas", "plan contratado"],
  },
  {
    question: "¿Tengo que pagar a Google para que aparezca mi negocio?",
    answer:
      "No. Crear y gestionar un Perfil de Empresa en Google es gratuito. Lo que pagas a 7D Studio es nuestro trabajo de optimización y seguimiento. Los anuncios de Google Ads son un servicio diferente.",
    questionStrong: ["pagar a Google"],
    answerStrong: ["No.", "es gratuito", "trabajo de optimización y seguimiento"],
    answerItalic: ["un servicio diferente"],
  },
  {
    question: "Mi negocio ya aparece en Google. ¿Necesito SEO local?",
    answer:
      "Puede que sí. Aparecer es solo el primer paso. Conviene revisar si tus servicios están bien explicados, si la información está actualizada y si tu ficha ayuda a los clientes a decidirse por tu negocio.",
    questionStrong: ["ya aparece en Google"],
    answerStrong: ["Puede que sí.", "servicios están bien explicados", "información está actualizada"],
  },
];

function formatFaqText(text: string, strong: string[], italic: string[] = []) {
  const phrases = [...strong, ...italic];
  if (phrases.length === 0) return [{ text, tag: "span" as const }];
  const pattern = phrases.map(phrase => phrase.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|");
  return text.split(new RegExp(`(${pattern})`, "g")).filter(Boolean).map(part => ({
    text: part,
    tag: strong.includes(part) ? "strong" as const : italic.includes(part) ? "em" as const : "span" as const,
  }));
}
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: `${site.url}/seo-local/`,
    about: {
      "@type": "Service",
      name: "SEO local",
      provider: { "@type": "Organization", name: site.name, url: site.url },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Inicio",
        item: `${site.url}/`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "SEO local",
        item: `${site.url}/seo-local/`,
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
>
  <Header />
  <main id="contenido" class="seo-page">
    <section class="seo-hero container" aria-labelledby="seo-title">
      <nav class="seo-hero__breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a><span aria-hidden="true">/</span><span
          aria-current="page">SEO local</span
        >
      </nav>
      <div class="seo-hero__layout">
        <div class="seo-hero__copy">
          <p class="seo-page__label">SEO LOCAL / 7D STUDIO</p>
          <h1 id="seo-title">
            <span class="seo-hero__statement"
              >Tus próximos clientes te están buscando en Google.</span
            >{" "}
            <span class="seo-hero__question">¿Te encuentran a ti?</span>
          </h1>
          <p class="seo-hero__description">
            Trabajamos tu presencia local para ayudarte a aparecer en búsquedas
            relevantes y transmitir confianza.
          </p>
          <a
            class="button"
            href={contactHref}
            target="_blank"
            rel="noopener noreferrer"
            >Quiero que encuentren mi negocio <span aria-hidden="true">↗</span
            ><span class="sr-only">
              por WhatsApp (se abre en una pestaña nueva)</span
            ></a
          >
          <a class="seo-hero__secondary" href="#como-funciona"
            >Primero, te contamos cómo funciona <span aria-hidden="true">↓</span
            ></a
          >
          <a class="seo-hero__secondary" href="#planes">Ver planes y precios <span aria-hidden="true">↓</span></a>
        </div>
        <SearchPreview />
      </div>
    </section>

    <section
      id="como-funciona"
      class="journey container"
      aria-labelledby="journey-title"
    >
      <div class="seo-page__heading">
        <h2 id="journey-title">
          El cliente necesita algo.<br />La pregunta es a quién encuentra.
        </h2>
        <p>
          Cuando alguien necesita un servicio, busca en Google, compara opciones
          y decide a quién contactar.
        </p>
      </div>
      <ol class="journey__steps">
        <li class="journey__step journey__step--search">
          <svg
            class="journey__icon"
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m21 21-4.34-4.34"></path>
            <circle cx="11" cy="11" r="8"></circle>
          </svg>
          <h3>Busca</h3>
          <p>Una persona necesita un servicio y lo busca en Google.</p>
          <div class="journey__example">
            <div class="journey__example-row">
              <svg
                class="journey__example-icon"
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {Search.map(([Tag, attributes]) => <Tag {...attributes} />)}
              </svg>
              <span>asesoría cerca de mí</span>
            </div>
            <span class="journey__example-caption">Búsqueda en Google</span>
          </div>
        </li>
        <li class="journey__step journey__step--compare">
          <svg
            class="journey__icon"
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3v18"></path>
            <path d="m19 8 3 8a5 5 0 0 1-6 0zV7"></path>
            <path d="M3 7h1a17 17 0 0 0 8-2 17 17 0 0 0 8 2h1"></path>
            <path d="m5 8 3 8a5 5 0 0 1-6 0zV7"></path>
            <path d="M7 21h10"></path>
          </svg>
          <h3>Compara</h3>
          <p>
            Encuentra distintos negocios. Consulta sus horarios, servicios,
            fotografías y reseñas.
          </p>
          <div class="journey__example">
            <div class="journey__example-rows">
              {
                ["Negocio A", "Negocio B"].map((name) => (
                  <div class="journey__example-row">
                    <svg
                      class="journey__example-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      {Store.map(([Tag, attributes]) => (
                        <Tag {...attributes} />
                      ))}
                    </svg>
                    <span>{name}</span>
                  </div>
                ))
              }
            </div>
            <span class="journey__example-caption">Compara opciones</span>
          </div>
        </li>
        <li class="journey__step journey__step--contact">
          <svg
            class="journey__icon"
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M13 2a9 9 0 0 1 9 9"></path>
            <path d="M13 6a5 5 0 0 1 5 5"></path>
            <path
              d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"
            ></path>
          </svg>
          <h3>Contacta</h3>
          <p>Escoge un negocio que le parece adecuado y fiable.</p>
          <div class="journey__example">
            <div class="journey__example-rows">
              <div class="journey__example-row">
                <svg
                  class="journey__example-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {Phone.map(([Tag, attributes]) => <Tag {...attributes} />)}
                </svg>
                <span>Llamar</span>
              </div>
              <div class="journey__example-row">
                <svg
                  class="journey__example-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {
                    MessageCircle.map(([Tag, attributes]) => (
                      <Tag {...attributes} />
                    ))
                  }
                </svg>
                <span>Escribir</span>
              </div>
            </div>
            <span class="journey__example-caption">Contacta con el negocio</span
            >
          </div>
        </li>
      </ol>
      <aside class="journey__takeaway" aria-labelledby="journey-takeaway-title">
        <p class="journey__takeaway-label">LO QUE ESTÁ EN JUEGO</p>
        <h3 id="journey-takeaway-title">
          Si no te encuentran, pueden acabar eligiendo a otro negocio.
        </h3>
        <p class="journey__takeaway-description">
          Por eso importa cuidar cómo aparece tu empresa cuando alguien busca lo
          que ofreces.
        </p>
      </aside>
    </section>

    <ProfileComparison />

    <section class="work" aria-labelledby="work-title">
      <div class="container work__layout">
        <div class="work__intro">
          <p class="seo-page__label">CÓMO TE AYUDAMOS</p>
          <h2 id="work-title">
            Que te encuentren.<br />Y entiendan por qué elegirte.
          </h2>
          <p>
            Nos ocupamos de traducir tu negocio a una presencia local clara,
            útil y cuidada.
          </p>
        </div>
        <div class="work__modules">
          {
            work.map((item) => (
              <article class="work__module">
                <svg
                  class:list={["work__icon", `work__icon--${item.id}`]}
                  xmlns="http://www.w3.org/2000/svg"
                  width="32"
                  height="32"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {item.icon.map(([Tag, attributes]) => (
                    <Tag {...attributes} />
                  ))}
                </svg>
                <p class="work__label">{item.label}</p>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
        <p class="work__scope">
          Estos bloques explican nuestra forma de trabajar. El alcance concreto
          depende del plan contratado.
        </p>
      </div>
    </section>

    <SeoPlans />

    <section id="preguntas-seo" class="faq container" aria-labelledby="faq-title">
      <div class="faq__intro">
        <p class="seo-page__label">SIN TECNICISMOS</p>
        <h2 id="faq-title">Es normal tener preguntas.</h2>
        <p>
          Estas son algunas de las primeras que suelen surgir al hablar de
          visibilidad local.
        </p>
      </div>
      <div class="faq__list">
        {
          faqs.map((faq) => (
            <details>
              <summary>
                <span>
                  {formatFaqText(faq.question, faq.questionStrong).map(({ text, tag: Tag }) => <Tag>{text}</Tag>)}
                </span>
                <span class="faq__indicator" aria-hidden="true" />
              </summary>
              {(Array.isArray(faq.answer) ? faq.answer : [faq.answer]).map(paragraph => (
                <p>
                  {formatFaqText(paragraph, faq.answerStrong, faq.answerItalic).map(({ text, tag: Tag }) => <Tag>{text}</Tag>)}
                </p>
              ))}
            </details>
          ))
        }
      </div>
    </section>

    <SeoContact />
  </main>
  <Footer />
</BaseLayout>

<style>
  .seo-page {
    color: var(--color-ink);
  }
  .seo-page a:focus-visible,
  .seo-page summary:focus-visible {
    outline: 2px solid #47563e;
    outline-offset: 5px;
  }
  .seo-page ::selection {
    background: #dce2d5;
    color: #171717;
  }
  .seo-page__label {
    margin: 0 0 20px;
    color: #59674f;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.6;
  }
  .seo-hero {
    padding-top: calc(var(--header-height) + 24px);
    padding-bottom: 72px;
  }
  .seo-hero__breadcrumb {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 24px;
    color: var(--color-muted);
    font-size: 12px;
  }
  .seo-hero__breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .seo-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 4vw, 56px);
    align-items: center;
  }
  .seo-hero__copy {
    min-width: 0;
  }
  .seo-hero h1 {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(40px, 4.1vw, 60px);
    font-weight: 450;
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .seo-hero__statement,
  .seo-hero__question {
    display: block;
  }
  .seo-hero__question {
    margin-top: 0.2em;
    color: #60734f;
  }
  .seo-hero__description {
    max-width: 43ch;
    margin: 24px 0 28px;
    color: var(--color-muted);
    font-size: 17px;
    line-height: 1.7;
  }
  .seo-hero__copy > .button {
    max-width: 100%;
    gap: 16px;
    text-wrap: pretty;
  }
  .seo-hero__secondary {
    display: flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    min-height: 44px;
    margin-top: 8px;
    color: #59674f;
    font-size: 14px;
    line-height: 1.6;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  h2 {
    margin: 0;
    font-size: clamp(30px, 3.3vw, 46px);
    font-weight: 450;
    line-height: 1.13;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .seo-page__heading {
    max-width: 790px;
    margin-bottom: 40px;
  }
  .seo-page__heading > p:not(.seo-page__label) {
    margin: 24px 0 0;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.7;
  }
  .journey {
    padding-block: 64px 80px;
    border-top: 1px solid var(--color-line);
  }
  .journey__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border: 1px solid #d4d9cd;
    border-radius: 18px;
    background: #e7e9e0;
    list-style: none;
  }
  .journey__steps > li {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 28px;
  }
  .journey__steps > li + li {
    border-left: 1px solid #cbd2c1;
  }
  .journey__step--search {
    --journey-icon-color: #a67838;
  }
  .journey__step--compare {
    --journey-icon-color: #a96553;
  }
  .journey__step--contact {
    --journey-icon-color: #617858;
  }
  .journey__icon {
    flex-shrink: 0;
    color: var(--journey-icon-color);
  }
  .journey h3 {
    margin: 22px 0 12px;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .journey__steps p {
    margin: 0 0 24px;
    color: #535d49;
    font-size: 15px;
    line-height: 1.7;
  }
  .journey__example {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    min-height: 128px;
    margin-top: auto;
    padding: 14px;
    border: 1px solid #d4d9cd;
    border-radius: 8px;
    background: #fff;
    font-size: 13px;
    line-height: 1.6;
  }
  .journey__example-rows {
    display: grid;
    gap: 6px;
  }
  .journey__example-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .journey__example-icon {
    color: var(--journey-icon-color);
  }
  .journey__example-caption {
    color: #535d49;
    font-size: 12px;
    line-height: 1.6;
  }
  .journey__takeaway {
    margin: 28px 0 0;
    padding: clamp(24px, 3vw, 36px);
    border-left: 3px solid #a67838;
    border-radius: 8px;
    background: #f0e9de;
    color: #24211d;
  }
  .journey__takeaway-label {
    margin: 0 0 12px;
    color: #605a52;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.6;
  }
  .journey__takeaway h3 {
    max-width: 39ch;
    margin: 0;
    font-size: clamp(24px, 2.5vw, 34px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .journey__takeaway-description {
    max-width: 75ch;
    margin: 16px 0 0;
    color: #605a52;
